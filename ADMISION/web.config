<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\admision.exe" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <handlerSettings>
          <handlerSetting name="debugFile" value=".\logs\ancm.log" />
          <handlerSetting name="debugLevel" value="FILE,ERROR" />
        </handlerSettings>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 100 MB. Por encima de este valor IIS responde 413.
               El FileService rechaza archivos que excedan MaxFileSizeInMB con mensaje amigable. -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
