    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/es.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8/dist/browser/signalr.min.js"></script>
    <link rel="icon" type="image/png" href="~/img/unamad.png" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/toastify-js/src/toastify.js"></script>
    <script src="~/js/helper.js"></script>
    <script src="~/js/admin/modal-api.js" asp-append-version="true"></script>

    <script>
        // Pre-aplicar tema y estado del sidebar antes de pintar (evita flash).
        (function () {
            try {
                var t = localStorage.getItem('adm-theme');
                if (t === 'dark') document.documentElement.classList.add('dark');
                if (localStorage.getItem('adm-sidebar-collapsed') === '1') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) { /* ignore */ }
        })();
    </script>

    <style>
        /* ── Sidebar transitions (slide en móvil) ───────────── */
        #sidebar {
            transition: transform 0.28s cubic-bezier(.4, 0, .2, 1);
        }
        #sidebar-overlay { transition: opacity 0.25s ease; }

        /* ── Floating panels (user card + notifications) ───── */
        #user-card,
        #notif-panel {
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        #user-card.hidden,
        #notif-panel.hidden {
            opacity: 0;
            transform: scale(0.96) translateY(-6px);
            pointer-events: none;
        }
        #user-card:not(.hidden),
        #notif-panel:not(.hidden) {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
        #user-card { transform-origin: bottom left; }
        #notif-panel { transform-origin: top right; }

        /* ── Notification pulse ring ──────────────────────── */
        #notif-bell.has-pulse::after {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 9999px;
            border: 2px solid #f54477;
            animation: notif-pulse 1.2s ease-out infinite;
        }
        @@keyframes notif-pulse {
            0%   { transform: scale(0.9); opacity: 1; }
            100% { transform: scale(1.4); opacity: 0; }
        }

        /* ── Scrollbars finos ──────────────────────────────── */
        #main-content::-webkit-scrollbar { width: 6px; }
        #main-content::-webkit-scrollbar-thumb {
            background: rgba(15, 18, 32, 0.12);
            border-radius: 999px;
        }
        html.dark #main-content::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.12); }
        #notif-list::-webkit-scrollbar { width: 5px; }
        #notif-list::-webkit-scrollbar-thumb {
            background: #dce0e8;
            border-radius: 999px;
        }
    </style>
</head>

