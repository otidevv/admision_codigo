                }

                @if (TempData["SwalError"] != null)
                {
                    <script>
                        (function () {
                            var msg = @Html.Raw(Json.Serialize(TempData["SwalError"]));
                            var detail = @Html.Raw(Json.Serialize(TempData["SwalErrorDetail"] ?? string.Empty));
                            console.group('%c🛑 Error en el servidor', 'color:#dc2626;font-weight:bold;');
                            console.error(msg);
                            if (detail) console.error(detail);
                            console.groupEnd();
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'No se pudo guardar',
                                    text: msg,
                                    footer: detail ? '<small class="text-muted">Detalle completo en la consola del navegador (F12).</small>' : '',
                                    confirmButtonColor: '#f54477',
                                    confirmButtonText: 'Entendido'
                                });
                            }
                        })();
                    </script>
                }
            </main>
        </div>
    </div>

    <script>
        /* ── Fade-up bootstrap (root: #main-content) ─────────────────────────
           Observa cada .fade-up dentro del scroll del main; agrega .is-in al
           entrar al viewport. Incluye un safety-net que fuerza la revelación
           de cualquier .fade-up que no haya disparado tras un tiempo corto
           (típicamente filas de acciones "Cancelar/Guardar" que caen en el
           rootMargin inferior o quedan dentro de un wrapper oculto al cargar).
        ──────────────────────────────────────────────────────────────────── */
        (function () {
            function revealAll() {
                document.querySelectorAll('.fade-up:not(.is-in)').forEach(function (el) {
                    el.classList.add('is-in');
                });
            }
            function bootstrapFadeUp(rootEl) {
                var targets = document.querySelectorAll('.fade-up:not(.is-in)');
                if (!('IntersectionObserver' in window)) {
                    targets.forEach(function (el) { el.classList.add('is-in'); });
                    return;
                }
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (en) {
                        if (en.isIntersecting) {
                            en.target.classList.add('is-in');
                            io.unobserve(en.target);
                        }
                    });
                }, { root: rootEl || null, rootMargin: '0px 0px -8% 0px', threshold: 0.01 });
                targets.forEach(function (el, i) {
                    el.style.transitionDelay = ((i % 6) * 60) + 'ms';
                    io.observe(el);
                });
                // Safety-net: tras 1.2s revelamos lo que falte (cubre acciones
                // de formulario que quedan fuera del rootMargin o se hicieron
                // visibles después del primer paint).
                setTimeout(revealAll, 1200);
            }
            window.ADM = window.ADM || {};
            window.ADM.refreshFadeUp = function () {
                bootstrapFadeUp(document.getElementById('main-content'));
            };
            function init() { bootstrapFadeUp(document.getElementById('main-content')); }
            if (document.readyState !== 'loading') init();
            else document.addEventListener('DOMContentLoaded', init);
        })();

        (function () {
            /* ── Active nav item ─────────────────────────── */
            var path = window.location.pathname.replace(/\/$/, '') || '/';
            var bestMatch = null;
            var bestLen = -1;
            document.querySelectorAll('.nav-item').forEach(function (a) {
                var href = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
                var matches = path === href || (href !== '/admin' && path.startsWith(href + '/'));
                if (matches && href.length > bestLen) {
                    bestMatch = a;
                    bestLen = href.length;
                }
            });
            // Si nada matchea sub-rutas, activa /admin solo cuando estamos exactamente ahí.
            if (!bestMatch && (path === '/admin' || path === '/')) {
                bestMatch = document.querySelector('.nav-item[href="/admin"]');
            }
            if (bestMatch) bestMatch.classList.add('active');

            /* ── Sidebar toggle (mobile drawer + desktop collapse) ── */
            var sidebar     = document.getElementById('sidebar');
            var overlay     = document.getElementById('sidebar-overlay');
            var toggleBtn   = document.getElementById('sidebar-toggle');
            var sidebarOpen = false;

            function openSidebar() {
                sidebarOpen = true;
                sidebar.classList.remove('-translate-x-full');
                sidebar.classList.add('translate-x-0');
                overlay.classList.remove('opacity-0', 'pointer-events-none');
                overlay.classList.add('opacity-100');
            }
            function closeSidebar() {
                sidebarOpen = false;
                sidebar.classList.add('-translate-x-full');
                sidebar.classList.remove('translate-x-0');
                overlay.classList.add('opacity-0', 'pointer-events-none');
                overlay.classList.remove('opacity-100');
            }
            function toggleCollapse() {
                var collapsed = document.documentElement.classList.toggle('sidebar-collapsed');
                try { localStorage.setItem('adm-sidebar-collapsed', collapsed ? '1' : '0'); } catch (e) { }
            }
            toggleBtn?.addEventListener('click', function () {
                if (window.innerWidth >= 1024) {
                    toggleCollapse();
                } else {
                    sidebarOpen ? closeSidebar() : openSidebar();
                }
            });
            overlay?.addEventListener('click', closeSidebar);
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 1024) closeSidebar();
            });

            /* ── Theme toggle (persistente) ──────────────── */
            var themeBtn = document.getElementById('theme-toggle');
            themeBtn?.addEventListener('click', function () {
                var isDark = document.documentElement.classList.toggle('dark');
                try { localStorage.setItem('adm-theme', isDark ? 'dark' : 'light'); } catch (e) { }
            });

            /* ── User card flotante (ancla al user-trigger del sidebar) ── */
            var trigger = document.getElementById('user-trigger');
            var card    = document.getElementById('user-card');
            var cardOpen = false;

            function positionCard() {
                if (!cardOpen) return;
                var rect = trigger.getBoundingClientRect();
                var vw = window.innerWidth;
                var vh = window.innerHeight;
                var cardW = card.offsetWidth || 256;
                var cardH = card.offsetHeight || 320;
                // Abre debajo del trigger (esquina derecha del topbar).
                var top  = Math.min(vh - cardH - 8, rect.bottom + 8);
                var left = Math.max(8, Math.min(vw - cardW - 8, rect.right - cardW));
                card.style.top  = top + 'px';
                card.style.left = left + 'px';
            }

            function openCard() {
                cardOpen = true;
                card.classList.remove('hidden');
                trigger.setAttribute('aria-expanded', 'true');
                requestAnimationFrame(positionCard);
                window.addEventListener('scroll', positionCard, true);
                window.addEventListener('resize', positionCard);
            }
            function closeCard() {
                cardOpen = false;
                card.classList.add('hidden');
                trigger.setAttribute('aria-expanded', 'false');
                window.removeEventListener('scroll', positionCard, true);
                window.removeEventListener('resize', positionCard);
            }

            trigger?.addEventListener('click', function (e) {
                e.stopPropagation();
                cardOpen ? closeCard() : openCard();
            });
            document.addEventListener('click', function (e) {
                if (cardOpen && !card.contains(e.target) && !trigger.contains(e.target)) closeCard();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    if (cardOpen) closeCard();
                    if (sidebarOpen) closeSidebar();
                    if (panelOpen) closePanel();
                }
            });

            /* ── Notifications bell + SignalR (idéntico a antes) ── */
            var bell       = document.getElementById('notif-bell');
            var panel      = document.getElementById('notif-panel');
            var badge      = document.getElementById('notif-badge');
            var listEl     = document.getElementById('notif-list');
            var subtitleEl = document.getElementById('notif-panel-subtitle');
            var markAllBtn = document.getElementById('notif-mark-all');
            var panelOpen  = false;

            function humanTime(iso) {
                var t = new Date(iso);
                var diff = (Date.now() - t.getTime()) / 1000;
                if (diff < 60) return 'hace unos segundos';
                if (diff < 3600) return 'hace ' + Math.floor(diff / 60) + ' min';
                if (diff < 86400) return 'hace ' + Math.floor(diff / 3600) + ' h';
                if (diff < 604800) return 'hace ' + Math.floor(diff / 86400) + ' d';
                return t.toLocaleString('es-PE', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            }
            function escapeHtml(s) {
                return (s || '').replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }
            function colorClasses(scheme) {
                var base = {
                    primary:   { border: 'border-primary-300',   icon: 'bg-primary-500 text-white' },
                    secondary: { border: 'border-secondary-300', icon: 'bg-secondary-500 text-white' },
                    success:   { border: 'border-emerald-300',   icon: 'bg-emerald-500 text-white' },
                    warning:   { border: 'border-amber-300',     icon: 'bg-amber-500 text-white' },
                    danger:    { border: 'border-rose-300',      icon: 'bg-rose-500 text-white' }
                };
                return base[scheme] || base.primary;
            }
            function renderItem(n) {
                var c = colorClasses(n.colorScheme);
                var unread = !n.isRead;
                var rowCls = unread ? ('border-l-4 ' + c.border) : 'border-l-4 border-transparent';
                var actionAttr = n.actionUrl ? (' data-action="' + encodeURI(n.actionUrl) + '"') : '';
                return ''
                    + '<div class="notif-item ' + rowCls + ' px-3 py-3 border-b border-ink-100 hover:bg-ink-50 cursor-pointer flex gap-3" data-id="' + n.id + '"' + actionAttr + '>'
                        + '<div class="w-9 h-9 rounded-md ' + c.icon + ' flex items-center justify-center shrink-0 shadow-sm">'
                            + '<i class="' + escapeHtml(n.iconClass || 'ti ti-bell') + ' text-xs"></i>'
                        + '</div>'
                        + '<div class="flex-1 min-w-0">'
                            + '<div class="flex items-start justify-between gap-2">'
                                + '<p class="text-[13px] font-extrabold text-ink-800 leading-snug">' + escapeHtml(n.title) + '</p>'
                                + (unread ? '<span class="w-2 h-2 rounded-full bg-primary-500 mt-1.5 shrink-0"></span>' : '')
                            + '</div>'
                            + '<p class="text-xs text-ink-600 leading-snug mt-0.5">' + escapeHtml(n.message) + '</p>'
                            + '<p class="text-[10px] text-ink-400 font-semibold mt-1.5"><i class="ti ti-clock text-[9px] mr-1"></i>' + humanTime(n.createdAt) + '</p>'
                        + '</div>'
                    + '</div>';
            }
            function renderEmpty() {
                listEl.innerHTML = ''
                    + '<div class="px-6 py-10 text-center">'
                        + '<div class="w-12 h-12 rounded-full bg-ink-100 flex items-center justify-center mx-auto mb-3">'
                            + '<i class="ti ti-bell-off text-ink-400"></i>'
                        + '</div>'
                        + '<p class="text-xs font-semibold text-ink-500">Sin notificaciones</p>'
                        + '<p class="text-[11px] text-ink-400 mt-0.5">Aquí verás los nuevos eventos del sistema.</p>'
                    + '</div>';
            }
            function updateBadge(unread) {
                if (unread > 0) {
                    badge.textContent = unread > 99 ? '99+' : String(unread);
                    badge.classList.remove('hidden');
                    bell.classList.add('has-pulse');
                    markAllBtn.classList.remove('hidden');
                    subtitleEl.textContent = unread + ' sin leer';
                } else {
                    badge.classList.add('hidden');
                    bell.classList.remove('has-pulse');
                    markAllBtn.classList.add('hidden');
                    subtitleEl.textContent = 'Estás al día';
                }
            }
            var latestCache = [];
            function renderList() {
                if (!latestCache.length) { renderEmpty(); return; }
                listEl.innerHTML = latestCache.map(renderItem).join('');
            }
            function loadList() {
                fetch('/admin/notifications/list?take=20', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        latestCache = data.items || [];
                        renderList();
                        updateBadge(data.unread || 0);
                    })
                    .catch(function () { renderEmpty(); subtitleEl.textContent = 'No disponible'; });
            }
            function loadUnreadCount() {
                fetch('/admin/notifications/unread-count', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) { updateBadge(data.unread || 0); })
                    .catch(function () { });
            }
            function positionPanel() {
                if (!panelOpen) return;
                var rect = bell.getBoundingClientRect();
                var vw = window.innerWidth;
                var panelW = panel.offsetWidth || 340;
                var top  = rect.bottom + 8;
                //var left = Math.max(8, Math.min(vw - panelW - 8, rect.right - panelW));
                panel.style.top  = top + 'px';
                panel.style.right = '10px';
            }

            function openPanel() {
                panelOpen = true;
                panel.classList.remove('hidden');
                bell.setAttribute('aria-expanded', 'true');
                requestAnimationFrame(positionPanel);
                window.addEventListener('scroll', positionPanel, true);
                window.addEventListener('resize', positionPanel);
                loadList();
            }
            function closePanel() {
                panelOpen = false;
                panel.classList.add('hidden');
                bell.setAttribute('aria-expanded', 'false');
                window.removeEventListener('scroll', positionPanel, true);
                window.removeEventListener('resize', positionPanel);
            }

            if (bell) {
                bell.addEventListener('click', function (e) {
                    e.stopPropagation();
                    panelOpen ? closePanel() : openPanel();
                });
                document.addEventListener('click', function (e) {
                    if (panelOpen && !panel.contains(e.target) && !bell.contains(e.target)) closePanel();
                });
                listEl.addEventListener('click', function (e) {
                    var it = e.target.closest('.notif-item');
                    if (!it) return;
                    var id = it.dataset.id;
                    var action = it.dataset.action;
                    fetch('/admin/notifications/mark-read/' + id, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                    }).catch(function () { });
                    if (action) window.location.href = action;
                });
                if (markAllBtn) {
                    markAllBtn.addEventListener('click', function () {
                        fetch('/admin/notifications/mark-all-read', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                        }).then(function () { loadList(); }).catch(function () { });
                    });
                }
                loadUnreadCount();
                if (window.signalR) {
                    var conn = new signalR.HubConnectionBuilder()
                        .withUrl('/hubs/notifications')
                        .withAutomaticReconnect()
                        .build();
                    conn.on('NotificationReceived', function (n) {
                        latestCache.unshift(n);
                        if (latestCache.length > 20) latestCache.pop();
                        if (panelOpen) renderList();
                        var current = parseInt(badge.textContent, 10) || 0;
                        updateBadge(Math.min(current + 1, 999));
                        if (typeof Toastify !== 'undefined') {
                            Toastify({
                                text: (n.title || 'Notificación') + ' — ' + (n.message || ''),
                                duration: 4000, gravity: 'top', position: 'right', stopOnFocus: true,
                                style: { background: '#f54477' },
                                onClick: function () { if (n.actionUrl) window.location.href = n.actionUrl; }
                            }).showToast();
                        }
                    });
                    conn.start().catch(function () { /* reintenta solo */ });
                }
            }
        }());

        /* ── Session timeout manager (sin cambios funcionales) ── */
        (function () {
            var SESSION_MS    = 2 * 60 * 60 * 1000;
            var WARN_BEFORE   = 2 * 60 * 1000;
            var POLL_MS       = 15 * 1000;
            var ACTIVITY_DEBOUNCE = 30 * 1000;

            var lastActivity = Date.now();
            var lastServerSync = 0;
            var modalShown = false;
            var redirecting = false;

            function resetActivity() {
                lastActivity = Date.now();
                if (modalShown) return;
                if (Date.now() - lastServerSync > ACTIVITY_DEBOUNCE) pingServer();
            }
            function pingServer() {
                lastServerSync = Date.now();
                return fetch('/admin/session/ping', {
                    method: 'GET', credentials: 'same-origin', cache: 'no-store', redirect: 'manual'
                }).then(function (r) {
                    if (r.type === 'opaqueredirect' || r.status === 401 || r.status === 403) {
                        forceExpire(); return null;
                    }
                    return r.json().catch(function () { return null; });
                }).catch(function () { return null; });
            }
            function forceExpire() {
                if (redirecting) return;
                redirecting = true;
                window.location.href = '/login?expired=1';
            }
            function logout() {
                if (redirecting) return;
                redirecting = true;
                window.location.href = '/login/logout?expired=1';
            }
            ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
                document.addEventListener(ev, resetActivity, { passive: true });
            });

            function showWarning(secondsLeft) {
                if (modalShown) return;
                modalShown = true;
                var deadline = Date.now() + secondsLeft * 1000;
                var timerId = null;
                Swal.fire({
                    icon: 'warning',
                    title: 'Tu sesión está por expirar',
                    html: '<p class="text-sm">Por seguridad cerraremos tu sesión por inactividad.</p>'
                        + '<p class="text-sm mt-1">Cerrando en <b id="sess-countdown">' + secondsLeft + '</b> s.</p>',
                    showCancelButton: true,
                    confirmButtonText: 'Continuar sesión',
                    cancelButtonText: 'Cerrar sesión',
                    confirmButtonColor: '#f54477',
                    cancelButtonColor: '#64748b',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: function () {
                        timerId = setInterval(function () {
                            var remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
                            var el = document.getElementById('sess-countdown');
                            if (el) el.textContent = remaining;
                            if (remaining <= 0) {
                                clearInterval(timerId);
                                Swal.close();
                                logout();
                            }
                        }, 250);
                    },
                    willClose: function () {
                        if (timerId) clearInterval(timerId);
                        modalShown = false;
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        pingServer().then(function (data) {
                            if (data && data.ok) lastActivity = Date.now();
                        });
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                        logout();
                    }
                });
            }

            setInterval(function () {
                if (redirecting || modalShown) return;
                var idle = Date.now() - lastActivity;
                if (idle >= SESSION_MS) logout();
                else if (idle >= SESSION_MS - WARN_BEFORE) {
                    var secondsLeft = Math.max(10, Math.ceil((SESSION_MS - idle) / 1000));
                    showWarning(secondsLeft);
                }
            }, POLL_MS);

            fetch('/admin/session/info', { credentials: 'same-origin', cache: 'no-store' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data || !data.ok) return;
                    var serverMs = data.secondsRemaining * 1000;
                    if (serverMs <= 0) { forceExpire(); return; }
                    lastActivity = Date.now() - (SESSION_MS - serverMs);
                })
                .catch(function () { });
        }());
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
