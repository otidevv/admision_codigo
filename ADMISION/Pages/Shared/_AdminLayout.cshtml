@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Token CSRF disponible globalmente para llamadas AJAX del layout (notificaciones, etc.).
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var userName = User.Identity?.Name ?? "Admin";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "A";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Administrador";
}

@functions {
    bool UserHasRole(string role) => User.IsInRole(role);
    bool UserHasAnyRole(params string[] roles) => roles.Any(r => User.IsInRole(r));
}
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
