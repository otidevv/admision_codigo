                @{
                    var __backCurrent = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant() ?? "";
                    var __backIsAdminRoot = __backCurrent == "/admin" || __backCurrent == "";
                }
                @if (!__backIsAdminRoot)
                {
                    <div class="mb-4">
                        <button type="button"
                                onclick="adminGoBack()"
                                class="inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold text-ink-600 dark:text-ink-300 hover:text-primary-600 hover:bg-white dark:hover:bg-ink-800 ring-soft rounded-md transition-colors"
                                title="Volver al nivel anterior">
                            <i class="ti ti-arrow-left text-xs"></i>
                            <span>Atrás</span>
                        </button>
                    </div>
                    <script>
                        // Calcula la ruta "padre lógica" desde la URL (ignora history).
                        function adminParentPath() {
                            const guid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
                            const isId = (s) => guid.test(s) || /^\d+$/.test(s);
                            const verbs = new Set([
                                'crear','create','new','nuevo',
                                'editar','edit',
                                'eliminar','delete',
                                'detalle','detail','detalles','ver','show','preview',
                                'validate','validation','validar','validacion'
                            ]);

                            let segments = window.location.pathname.split('/').filter(s => s.length > 0);
                            if (segments.length <= 1) return '/admin';

                            let trimmed = false, changed = true;
                            while (changed && segments.length > 1) {
                                changed = false;
                                const last = segments[segments.length - 1];
                                if (isId(last) || verbs.has(last.toLowerCase())) {
                                    segments.pop();
                                    trimmed = true;
                                    changed = true;
                                }
                            }
                            if (!trimmed && segments.length > 1) segments.pop();
                            return '/' + segments.join('/');
                        }

                        function adminGoBack() {
                            const target = adminParentPath();
                            if (target && target !== window.location.pathname.replace(/\/$/, '')) {
                                window.location.href = target;
                            } else {
                                window.location.href = '/admin';
                            }
                        }
                    </script>
                }

                @if (TempData["Success"] != null)
