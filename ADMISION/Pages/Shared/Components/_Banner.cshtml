@using ADMISION.ENTITIES.Models.Info
@{
    var dbBanners     = (ViewData["DBBanners"] as List<Banner>) ?? new List<Banner>();
    var activeBanners = dbBanners.Where(b => b.IsActive && !string.IsNullOrWhiteSpace(b.ImageUrl)).ToList();
    var hasBanners    = activeBanners.Count > 0;
    var firstBanner   = hasBanners ? activeBanners[0] : null;
    var bgColor       = ViewData["BannerBgColor"]?.ToString() ?? "#0f172a";
}

@if (hasBanners)
{
    <section class="relative w-full overflow-hidden bg-ink-1000" id="bannerSection">
        @for (int i = 0; i < activeBanners.Count; i++)
        {
            var b = activeBanners[i];
            <div class="banner-slide @(i == 0 ? "active" : "")" data-index="@i">
                <img src="/@b.ImageUrl"
                     alt=""
                     class="banner-img horizontal"
                     loading="@(i == 0 ? "eager" : "lazy")" />
                <img src="/@(string.IsNullOrEmpty(b.ImageUrlVertical) ? b.ImageUrl : b.ImageUrlVertical)"
                     alt=""
                     class="banner-img vertical"
                     loading="@(i == 0 ? "eager" : "lazy")" />
            </div>
        }

        <!-- CTAs at bottom center -->
        <div class="absolute bottom-6 sm:bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col sm:flex-row items-center gap-3 w-full px-4 max-w-[600px] mx-auto">
            <a href="#examenes"
               class="inline-flex items-center justify-center gap-2 text-[15px] font-medium px-6 py-3.5 rounded-md w-full bg-primary-600 text-white hover:bg-primary-700 transition-all shadow-lg shadow-primary-600/25">
                <i class="ti ti-user-plus"></i>
                Postular ahora
            </a>
            <a href="/consulta-inscripcion"
               class="inline-flex items-center justify-center gap-2 text-[15px] font-medium px-6 py-3.5 rounded-md w-full bg-secondary-1000 text-white hover:bg-secondary-900 transition-all ring-1 ring-white/30">
                <i class="ti ti-search"></i>
                Consulta tu inscripción
            </a>
        </div>

        @if (activeBanners.Count > 1)
        {
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 mb-16 sm:mb-20">
                @for (int i = 0; i < activeBanners.Count; i++)
                {
                    <button type="button" class="banner-dot @(i == 0 ? "active" : "")" data-index="@i" aria-label="Banner @(i+1)"></button>
                }
            </div>
        }
    </section>
}
else
{
    <section class="relative w-full overflow-hidden bg-ink-1000">
        <div class="w-full">
            <img src="/img/bg-1.png"
                 alt=""
                 class="w-full h-auto banner-img" />
        </div>
        <div class="absolute bottom-6 sm:bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col sm:flex-row items-center gap-3 w-full px-4 max-w-[600px] mx-auto">
            <a href="#examenes"
               class="inline-flex items-center justify-center gap-2 text-[15px] font-medium px-6 py-3.5 rounded-md w-full bg-primary-600 text-white hover:bg-primary-700 transition-all shadow-lg shadow-primary-600/25">
                <i class="ti ti-user-plus"></i>
                Postular ahora
            </a>
            <a href="/consulta-inscripcion"
               class="inline-flex items-center justify-center gap-2 text-[15px] font-medium px-6 py-3.5 rounded-md w-full bg-secondary-1000 text-white hover:bg-secondary-900 transition-all ring-1 ring-white/30">
                <i class="ti ti-search"></i>
                Consulta tu inscripción
            </a>
        </div>
    </section>
}

<style>
    #bannerSection .banner-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
        pointer-events: none;
    }
    #bannerSection .banner-slide.active {
        position: relative;
        opacity: 1;
        pointer-events: auto;
    }
    #bannerSection .banner-img {
        width: 100%;
        height: auto;
        display: block;
    }
    @@media (max-width: 767.98px) {
        #bannerSection .banner-img.horizontal { display: none; }
    }
    @@media (min-width: 768px) {
        #bannerSection .banner-img.vertical { display: none; }
    }
    .banner-dot {
        width: 10px;
        height: 10px;
        border-radius: 9999px;
        background: rgba(255,255,255,0.3);
        border: none;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
        padding: 0;
    }
    .banner-dot.active {
        background: #fff;
        transform: scale(1.3);
    }
    .banner-dot:hover {
        background: rgba(255,255,255,0.6);
    }
</style>

@if (hasBanners && activeBanners.Count > 1)
{
    <script>
        (function () {
            var slides = document.querySelectorAll('#bannerSection .banner-slide');
            var dots = document.querySelectorAll('#bannerSection .banner-dot');
            if (!slides.length) return;
            var current = 0;
            var interval = null;

            function goTo(index) {
                if (index === current) return;
                slides[current].classList.remove('active');
                if (dots.length) dots[current].classList.remove('active');
                current = index;
                slides[current].classList.add('active');
                if (dots.length) dots[current].classList.add('active');
            }

            function next() { goTo((current + 1) % slides.length); }
            function startAuto() { stopAuto(); interval = setInterval(next, 6000); }
            function stopAuto() { if (interval) { clearInterval(interval); interval = null; } }

            dots.forEach(function (dot) {
                dot.addEventListener('click', function () {
                    stopAuto();
                    goTo(parseInt(this.dataset.index));
                    setTimeout(startAuto, 8000);
                });
            });

            var section = document.getElementById('bannerSection');
            if (section) {
                section.addEventListener('mouseenter', stopAuto);
                section.addEventListener('mouseleave', startAuto);
            }

            startAuto();
        })();
    </script>
}

<!-- Exams / modality cards -->
<div class="relative mt-5 px-4 sm:px-6 lg:px-8 z-20" id="examenes">
    <div class="max-w-5xl mx-auto">

        @{
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var activeExams = (ViewData["Exams"] as List<ADMISION.ENTITIES.Models.Modality.Modality>)
                ?.Where(e => e.IsActive && e.StartDate <= today)
                .ToList() ?? new();
        }

        @if (activeExams.Any())
        {
            <div class="text-center mb-6 fade-up">
                <span class="inline-flex items-center gap-2 bg-white ring-soft py-2 px-6 rounded-full shadow-sm">
                    <i class="ti ti-bookmark text-primary-500 text-sm"></i>
                    <span class="text-sm sm:text-base font-semibold text-ink-800 tracking-tight">Selecciona tu modalidad de examen</span>
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                @{
                    var palettes = new[] {
                        new { iconBg = "bg-primary-100",   iconText = "text-primary-600",   orbBg = "bg-primary-500/15",   cta = "text-primary-600" },
                        new { iconBg = "bg-secondary-100", iconText = "text-secondary-600", orbBg = "bg-secondary-500/15", cta = "text-secondary-600" },
                        new { iconBg = "bg-primary-50",    iconText = "text-primary-700",   orbBg = "bg-primary-500/10",   cta = "text-primary-700" },
                        new { iconBg = "bg-secondary-50",  iconText = "text-secondary-700", orbBg = "bg-secondary-500/10", cta = "text-secondary-700" }
                    };
                    int idx = 0;
                }

                @foreach (var exam in activeExams)
                {
                    var p = palettes[idx % palettes.Length];
                    <a href="/inscription?modalityId=@exam.Id"
                       class="lift fade-up group relative bg-white ring-soft rounded-xl p-6 sm:p-7 flex flex-col gap-4 overflow-hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 shadow-sm">
                        <div class="relative w-12 h-12 sm:w-14 sm:h-14 rounded-xl @p.iconBg flex items-center justify-center text-xl sm:text-2xl shrink-0 transition-transform duration-200 group-hover:scale-110">
                            <i class="ti ti-school @p.iconText"></i>
                        </div>
                        <span class="relative text-[15px] sm:text-lg font-semibold text-ink-800 leading-snug line-clamp-2 tracking-tight">@exam.Name</span>
                        @if (!string.IsNullOrEmpty(exam.PublicSummary))
                        {
                            <p class="relative text-xs sm:text-sm text-ink-500 leading-relaxed line-clamp-2">@exam.PublicSummary</p>
                        }
                        <span class="relative inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold @p.cta mt-auto">
                            Inscribirse
                            <i class="ti ti-arrow-right text-[10px] transition-transform duration-150 group-hover:translate-x-1"></i>
                        </span>
                    </a>
                    idx++;
                }
            </div>
        }
    </div>
</div>