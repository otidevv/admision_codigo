@using ADMISION.ENTITIES.Models.Modality
@{
    var careers = ViewData["Careers"] as List<Career> ?? new List<Career>();
}

@if (careers.Count > 0)
{
    var duplicated = careers.Concat(careers).ToList();

    <section class="relative py-20 sm:py-24 md:py-28 overflow-hidden">

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">

            <!-- Section header -->
            <div class="max-w-2xl mx-auto text-center mb-12 sm:mb-14 fade-up">
                <div class="inline-flex items-center gap-2 glass ring-soft rounded-full px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-primary-700 mb-5">
                    <i class="ti ti-school text-[10px]"></i>
                    Nuestras Carreras
                </div>
                <h2 class="text-3xl sm:text-4xl md:text-[44px] font-semibold tracking-[-0.025em] leading-[1.05] text-ink-900 mb-3">
                    Carreras <span class="font-serif font-normal text-primary-600">profesionales</span>
                </h2>
                <p class="text-ink-500 text-sm sm:text-base leading-relaxed">
                    Conoce la oferta académica que tenemos para ti en este proceso de admisión.
                </p>
            </div>
        </div>

        <!-- Full-width marquee -->
        <div class="relative overflow-hidden" style="mask-image:linear-gradient(to right,transparent,black 5%,black 95%,transparent);-webkit-mask-image:linear-gradient(to right,transparent,black 5%,black 95%,transparent)">
            <div class="flex marquee-track" style="width:fit-content;animation:marquee @(careers.Count * 3)s linear infinite">
                @foreach (var career in duplicated)
                {
                    <a href="/carreras/@career.Id" class="group flex-shrink-0 w-[280px] sm:w-[400px] mr-6 sm:mr-8 flex flex-col items-center gap-4 text-center hover:-translate-y-1 transition-all duration-300">
                        @if (!string.IsNullOrEmpty(career.LogoUrl))
                        {
                            <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden ring-1 ring-white/30 flex items-center justify-center bg-white/80 group-hover:ring-primary-200 transition-all">
                                <img src="/@career.LogoUrl"
                                     alt="@career.Name"
                                     class="w-full h-full object-contain p-3" />
                            </div>
                        }
                        else
                        {
                            <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-white/60 ring-1 ring-white/30 flex items-center justify-center group-hover:bg-primary-100 group-hover:ring-primary-200 transition-all">
                                <span class="text-primary-700 font-bold text-xl sm:text-2xl tracking-tight">
                                    @(!string.IsNullOrEmpty(career.Initials) ? career.Initials.ToUpper() : career.Name.Length >= 2 ? career.Name[..2].ToUpper() : "?")
                                </span>
                            </div>
                        }
                        <span class="text-sm sm:text-xl font-semibold text-ink-700 leading-snug group-hover:text-primary-600 transition-colors">
                            @career.Name
                        </span>
                    </a>
                }
            </div>
        </div>

        <style>
            .marquee-track:hover {
                animation-play-state: paused !important;
            }
        </style>
    </section>
}

<style>
    @@keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }
</style>