@using ADMISION.ENTITIES.Constants
@inject ADMISION.Services.Interfaces.IConfigService ConfigService

@{
    var configs = await ConfigService.GetAllConfigsAsync();
    var institutionName = configs.GetValueOrDefault(ConfigGeneral.NombreInstitucion, "Portal de Admisión");
    var address  = configs.GetValueOrDefault(ConfigGeneral.Direccion, "Av. Universidad 123, Ciudad Universitaria");
    var phone    = configs.GetValueOrDefault(ConfigGeneral.Telefono, "(01) 123-4567");
    var email    = configs.GetValueOrDefault(ConfigGeneral.CorreoInstitucional, "admision@universidad.edu.pe");
    var schedule = configs.GetValueOrDefault(ConfigGeneral.HorarioAtencion, "Lun - Vie: 8:00 AM - 6:00 PM");

    var facebook  = configs.GetValueOrDefault(ConfigGeneral.Facebook,  "");
    var twitter   = configs.GetValueOrDefault(ConfigGeneral.Twitter,   "");
    var instagram = configs.GetValueOrDefault(ConfigGeneral.Instagram, "");
    var youtube   = configs.GetValueOrDefault(ConfigGeneral.Youtube,   "");

    bool hasSocial = new[] { facebook, twitter, instagram, youtube }
        .Any(s => !string.IsNullOrWhiteSpace(s) && s != "#");
}

<footer class="relative mt-20 sm:mt-24 text-ink-300 overflow-hidden bg-secondary-1000">

    <!-- Banda superior sólida -->
    <div class="h-1 bg-primary"></div>

    <!-- Decorativos: dotgrid + blobs de color sólido (no gradientes) -->
    <div class="absolute inset-0 dotgrid opacity-20 pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 py-14 sm:py-16 relative">

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">

            <!-- About Section -->
            <div class="lg:col-span-1 fade-up">
                <div class="flex items-center gap-3 mb-4">
                    <span class="w-11 h-11 rounded-md inline-flex items-center justify-center text-white shrink-0 bg-primary shadow-glow">
                        <i class="ti ti-school text-white text-lg"></i>
                    </span>
                    <div>
                        <h3 class="text-white font-bold text-base leading-tight tracking-tight">@institutionName</h3>
                        <p class="text-[10px] font-bold text-primary-300 uppercase tracking-[0.2em] mt-0.5">Admisión</p>
                    </div>
                </div>
                <p class="text-sm text-ink-400 leading-relaxed">
                    Tu futuro comienza aquí. Únete a nuestra comunidad académica y alcanza tus metas profesionales.
                </p>
            </div>

            <!-- Quick Links -->
            <div class="fade-up">
                <h4 class="text-white font-semibold mb-4 text-xs uppercase tracking-[0.22em] flex items-center gap-2">
                    <span class="w-1 h-4 bg-primary-500 rounded-full"></span>
                    Enlaces Rápidos
                </h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="/" class="group inline-flex items-center gap-2 text-ink-400 hover:text-primary-300 transition-colors"><i class="ti ti-chevron-right text-[9px] text-primary-500 group-hover:translate-x-0.5 transition-transform"></i><span>Inicio</span></a></li>
                    <li><a href="/modalidad" class="group inline-flex items-center gap-2 text-ink-400 hover:text-primary-300 transition-colors"><i class="ti ti-chevron-right text-[9px] text-primary-500 group-hover:translate-x-0.5 transition-transform"></i><span>Modalidades</span></a></li>
                    <li><a href="/carreras" class="group inline-flex items-center gap-2 text-ink-400 hover:text-primary-300 transition-colors"><i class="ti ti-chevron-right text-[9px] text-primary-500 group-hover:translate-x-0.5 transition-transform"></i><span>Carreras</span></a></li>
                    <li><a href="/documentos" class="group inline-flex items-center gap-2 text-ink-400 hover:text-primary-300 transition-colors"><i class="ti ti-chevron-right text-[9px] text-primary-500 group-hover:translate-x-0.5 transition-transform"></i><span>Documentos</span></a></li>
                    <li><a href="/cronograma" class="group inline-flex items-center gap-2 text-ink-400 hover:text-primary-300 transition-colors"><i class="ti ti-chevron-right text-[9px] text-primary-500 group-hover:translate-x-0.5 transition-transform"></i><span>Cronograma</span></a></li>
                    <li><a href="/resultados" class="group inline-flex items-center gap-2 text-ink-400 hover:text-primary-300 transition-colors"><i class="ti ti-chevron-right text-[9px] text-primary-500 group-hover:translate-x-0.5 transition-transform"></i><span>Resultados</span></a></li>
                </ul>
            </div>

            <!-- Contact Info -->
            <div class="fade-up">
                <h4 class="text-white font-semibold mb-4 text-xs uppercase tracking-[0.22em] flex items-center gap-2">
                    <span class="w-1 h-4 bg-secondary-400 rounded-full"></span>
                    Contacto
                </h4>
                <ul class="space-y-3 text-sm">
                    <li class="flex items-start gap-3">
                        <span class="w-7 h-7 rounded-md bg-white/5 ring-1 ring-white/10 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="ti ti-map-pin text-primary-400 text-xs"></i>
                        </span>
                        <span class="text-ink-400 leading-relaxed">@address</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="w-7 h-7 rounded-md bg-white/5 ring-1 ring-white/10 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="ti ti-phone text-primary-400 text-xs"></i>
                        </span>
                        <a href="tel:@phone" class="text-ink-400 hover:text-primary-300 transition-colors">@phone</a>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="w-7 h-7 rounded-md bg-white/5 ring-1 ring-white/10 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="ti ti-mail text-primary-400 text-xs"></i>
                        </span>
                        <a href="mailto:@email" class="text-ink-400 hover:text-primary-300 transition-colors break-all">@email</a>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="w-7 h-7 rounded-md bg-white/5 ring-1 ring-white/10 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="ti ti-clock text-primary-400 text-xs"></i>
                        </span>
                        <span class="text-ink-400 leading-relaxed">@schedule</span>
                    </li>
                </ul>
            </div>

            <!-- Social Media / CTA -->
            <div class="fade-up">
                <h4 class="text-white font-semibold mb-4 text-xs uppercase tracking-[0.22em] flex items-center gap-2">
                    <span class="w-1 h-4 bg-primary-500 rounded-full"></span>
                    Síguenos
                </h4>
                @if (hasSocial)
                {
                    <div class="flex flex-wrap gap-2.5 mb-5">
                        @if (!string.IsNullOrWhiteSpace(facebook) && facebook != "#")
                        {
                            <a href="@facebook" target="_blank" rel="noopener" aria-label="Facebook"
                               class="w-10 h-10 bg-white/5 ring-1 ring-white/10 hover:bg-primary-500 hover:ring-primary-400 rounded-md flex items-center justify-center transition-all hover:-translate-y-0.5">
                                <i class="ti ti-brand-facebook text-white text-sm"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(twitter) && twitter != "#")
                        {
                            <a href="@twitter" target="_blank" rel="noopener" aria-label="X / Twitter"
                               class="w-10 h-10 bg-white/5 ring-1 ring-white/10 hover:bg-primary-500 hover:ring-primary-400 rounded-md flex items-center justify-center transition-all hover:-translate-y-0.5">
                                <i class="ti ti-brand-x text-white text-sm"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(instagram) && instagram != "#")
                        {
                            <a href="@instagram" target="_blank" rel="noopener" aria-label="Instagram"
                               class="w-10 h-10 bg-white/5 ring-1 ring-white/10 hover:bg-primary-500 hover:ring-primary-400 rounded-md flex items-center justify-center transition-all hover:-translate-y-0.5">
                                <i class="ti ti-brand-instagram text-white text-sm"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(youtube) && youtube != "#")
                        {
                            <a href="@youtube" target="_blank" rel="noopener" aria-label="YouTube"
                               class="w-10 h-10 bg-white/5 ring-1 ring-white/10 hover:bg-primary-500 hover:ring-primary-400 rounded-md flex items-center justify-center transition-all hover:-translate-y-0.5">
                                <i class="ti ti-brand-youtube text-white text-sm"></i>
                            </a>
                        }
                    </div>
                }

                <a href="#examenes"
                   class="btn-grad inline-flex items-center justify-center gap-2 w-full text-sm font-semibold px-4 py-3 rounded-md transition-all hover:-translate-y-0.5">
                    <i class="ti ti-user-plus"></i>
                    <span>Postular ahora</span>
                </a>
            </div>
        </div>

        <!-- Copyright -->
        <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-ink-500">
            <p class="text-center sm:text-left">
                &copy; @DateTime.Now.Year
                <span class="text-ink-300 font-semibold">@institutionName</span>.
                Todos los derechos reservados.
            </p>
            <div class="flex items-center gap-4 text-xs">
                <span class="inline-flex items-center gap-1.5">
                    <span class="relative inline-flex w-2 h-2">
                        <span class="absolute inset-0 rounded-full bg-emerald-400 pulse-dot"></span>
                        <span class="relative inline-flex w-2 h-2 rounded-full bg-emerald-500"></span>
                    </span>
                    Proceso activo
                </span>
            </div>
        </div>
    </div>
</footer>
