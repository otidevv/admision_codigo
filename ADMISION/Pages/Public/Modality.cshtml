@model ADMISION.Models.ViewModels.Public.ModalityPublicViewModel
@{
    ViewData["Title"] = "Modalidades";
    Layout = "~/Pages/Shared/_PublicLayout.cshtml";
}

<section class="relative py-12 sm:py-16 md:py-20 overflow-hidden">


    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">

        <!-- Page hero -->
        <div class="text-center mb-10 sm:mb-12 fade-up max-w-2xl mx-auto">
            <div class="inline-flex items-center gap-2 bg-white ring-soft rounded-full px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-primary-700 mb-5">
                <i class="ti ti-file-text text-[10px]"></i>
                Proceso de Admisión
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-[44px] font-semibold tracking-[-0.025em] leading-[1.05] text-ink-900 mb-3">
                Modalidades y <span class="font-serif font-normal text-primary-600">requisitos</span>
            </h1>
            <p class="text-ink-500 text-sm sm:text-base leading-relaxed">
                Ofrecemos una gran variedad de modalidades de acceso a nuestra universidad. Selecciona la modalidad
                que corresponde a tu caso y revisa los requisitos necesarios.
            </p>

            <div class="flex items-center justify-center gap-4 sm:gap-4 mt-6 flex-wrap text-xs text-ink-600">
                <div class="inline-flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-primary-500 inline-block"></span>
                    <strong class="font-bold text-ink-900">@Model.Modalities.Count</strong> modalidades disponibles
                </div>
                <div class="hidden sm:block w-px h-4 bg-ink-200"></div>
                <div class="inline-flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-secondary-500 inline-block"></span>
                    Proceso <strong class="font-bold text-ink-900">@(Model.SelectedTerm?.Name ?? "—")</strong>
                </div>
            </div>
        </div>

        @if (Model.SelectedTerm == null)
        {
            <div class="bg-white ring-soft rounded-md py-16 sm:py-20 text-center">
                <i class="ti ti-alert-circle text-3xl text-ink-300 mb-3 block"></i>
                <p class="text-ink-500 font-medium text-sm">No hay un período académico activo en este momento.</p>
            </div>
        }
        else if (!Model.Modalities.Any())
        {
            <div class="bg-white ring-soft rounded-md py-16 sm:py-20 text-center">
                <i class="ti ti-history text-3xl text-ink-300 mb-3 block"></i>
                <p class="text-ink-500 font-medium text-sm">
                    No hay modalidades publicadas para este proceso.
                </p>
            </div>
        }
        else
        {
            <div class="space-y-3" id="accordion-modalidades">
                @foreach (var mod in Model.Modalities)
                {
                    var isActive   = mod.IsActive;
                    var badgeClass = mod.Badge == "Principal"
                        ? "bg-primary text-white"
                        : "bg-secondary-100 text-secondary-700";

                    <div id="mod-@mod.Slug"
                         class="mod-card bg-white ring-soft rounded-md transition-all duration-200 overflow-hidden @(isActive ? "is-open" : "")">
                        <button type="button" onclick="toggleMod('@mod.Slug')"
                                id="header-@mod.Slug"
                                aria-expanded="@(isActive ? "true" : "false")"
                                aria-controls="content-@mod.Slug"
                                class="mod-header w-full flex items-center gap-3 sm:gap-4 px-4 sm:px-5 py-4 sm:py-5 text-left transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400">
                            <span class="mod-icon shrink-0 w-10 h-10 sm:w-11 sm:h-11 rounded-md bg-primary-50 ring-1 ring-primary-100 flex items-center justify-center transition-colors duration-200">
                                <i class="@mod.IconKey text-primary-600 text-sm sm:text-base transition-colors duration-200"></i>
                            </span>
                            <span class="flex-1 flex flex-wrap items-center gap-2 min-w-0">
                                <span id="title-@mod.Slug" class="mod-title font-bold text-ink-800 text-sm sm:text-[15px] uppercase tracking-[0.06em] leading-snug transition-colors duration-200">
                                    @if (!string.IsNullOrWhiteSpace(mod.TypeName))
                                    {
                                        @mod.TypeName <span class="font-medium text-ink-500 normal-case tracking-normal">(@mod.ModalityName)</span>
                                    }
                                    else
                                    {
                                        @mod.ModalityName
                                    }
                                </span>
                                @if (mod.DiscountPercentage > 0)
                                {
                                    <span class="text-[10px] bg-primary text-white px-2 py-0.5 rounded-full font-bold shrink-0">
                                        -@mod.DiscountPercentage.ToString("0.##")%
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(mod.Badge))
                                {
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0 @badgeClass">
                                        @mod.Badge
                                    </span>
                                }
                            </span>
                            <i id="chevron-@mod.Slug" class="mod-chevron ti ti-chevron-down text-ink-400 text-xs shrink-0 transition-transform duration-300 @(isActive ? "rotate-180" : "")"></i>
                        </button>

                        <div id="content-@mod.Slug" class="mod-content @(isActive ? "block" : "hidden") border-t border-ink-200/60">
                            @if (!string.IsNullOrWhiteSpace(mod.Summary))
                            {
                                <div class="px-4 sm:px-6 pt-5 pb-4 bg-primary-50/60 border-b border-primary-100">
                                    <p class="text-[11px] font-bold text-primary-700 uppercase tracking-[0.15em] mb-1.5">
                                        @(string.IsNullOrWhiteSpace(mod.TypeName) ? "Descripción" : "Dirigido a")
                                    </p>
                                    <p class="text-ink-800 text-sm leading-relaxed">@Html.Raw(mod.Summary)</p>
                                </div>
                            }
                            @if (mod.InfoBlocks.Any())
                            {
                                <div class="px-4 sm:px-6 pb-5 border-t border-ink-100">
                                    <div class="pt-5 space-y-3">
                                        @foreach (var block in mod.InfoBlocks)
                                        {
                                            <div class="rounded-md ring-1 ring-primary-100 bg-white p-4 hover:ring-primary-200 transition-all">
                                                <div class="flex items-center gap-2 mb-2">
                                                    <span class="w-6 h-6 rounded-md bg-primary-100 flex items-center justify-center shrink-0">
                                                        <i class="ti ti-info-circle text-primary-600 text-[10px]"></i>
                                                    </span>
                                                    <h4 class="text-[13px] font-bold text-primary-700 uppercase tracking-[0.14em]">@block.Title</h4>
                                                </div>
                                                <div class="text-xs sm:text-[13px] text-ink-700 leading-relaxed whitespace-pre-line">@block.Description</div>
                                                @if (!string.IsNullOrWhiteSpace(block.Url))
                                                {
                                                    <a href="@block.Url" target="_blank" rel="noopener"
                                                       class="inline-flex items-center gap-2 mt-3 text-[11px] font-bold text-primary-600 hover:text-primary-700">
                                                        <span>Ver más</span>
                                                        <i class="ti ti-external-link text-[9px]"></i>
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

@*                             @if (mod.ExamDate.HasValue || mod.ResultsPublicationDate.HasValue)
                            {
                                <div class="px-4 sm:px-6 py-4 border-b border-ink-100 grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @if (mod.ExamDate.HasValue)
                                    {
                                        <div class="flex items-center gap-3 rounded-md ring-1 ring-primary-200 bg-primary-50 px-4 py-3">
                                            <span class="w-10 h-10 rounded-md bg-white ring-1 ring-primary-200 flex items-center justify-center shrink-0">
                                                <i class="ti ti-file-pencil text-primary-600 text-sm"></i>
                                            </span>
                                            <div class="min-w-0">
                                                <p class="text-[10px] font-bold text-primary-700 uppercase tracking-[0.16em]">Fecha del Examen</p>
                                                <p class="text-sm font-bold text-ink-900 leading-snug">@mod.ExamDate.Value.ToString("dd 'de' MMMM 'del' yyyy", new System.Globalization.CultureInfo("es-PE"))</p>
                                            </div>
                                        </div>
                                    }
                                    @if (mod.ResultsPublicationDate.HasValue)
                                    {
                                        <div class="flex items-center gap-3 rounded-md ring-1 ring-secondary-200 bg-secondary-50 px-4 py-3">
                                            <span class="w-10 h-10 rounded-md bg-white ring-1 ring-secondary-200 flex items-center justify-center shrink-0">
                                                <i class="ti ti-award text-secondary-600 text-sm"></i>
                                            </span>
                                            <div class="min-w-0">
                                                <p class="text-[10px] font-bold text-secondary-700 uppercase tracking-[0.16em]">Publicación de Resultados</p>
                                                <p class="text-sm font-bold text-ink-900 leading-snug">@mod.ResultsPublicationDate.Value.ToString("dd 'de' MMMM 'del' yyyy", new System.Globalization.CultureInfo("es-PE"))</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            } *@

                            <div class="px-4 sm:px-6 py-5 grid grid-cols-1 @(mod.EntryRequirements.Any() ? "md:grid-cols-2" : "") gap-4 md:gap-4">
                                <div class="@(mod.EntryRequirements.Any() ? "" : "md:col-span-2") rounded-md ring-1 ring-primary-100 bg-primary-50/40 p-4">
                                    <div class="flex items-center gap-2 mb-3 pb-2 border-b border-primary-100">
                                        <span class="w-7 h-7 rounded-md bg-primary-100 flex items-center justify-center shrink-0">
                                            <i class="ti ti-clipboard-list text-primary-600 text-[11px]"></i>
                                        </span>
                                        <p class="text-xs font-bold text-primary-700 uppercase tracking-[0.14em]">Requisitos para Postular</p>
                                    </div>
                                    @if (mod.PostulationRequirements.Any() || mod.PaymentRequirements.Any())
                                    {
                                        <ul class="space-y-2">
                                            @foreach (var req in mod.PostulationRequirements)
                                            {
                                                <li class="flex gap-2 text-xs sm:text-[13px] text-ink-700 leading-relaxed">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-primary-500 mt-1.5 shrink-0"></span>
                                                    <span>@req</span>
                                                </li>
                                            }
                                            @foreach (var pay in mod.PaymentRequirements)
                                            {
                                                <li class="flex gap-2 text-xs sm:text-[13px] text-ink-700 leading-relaxed">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-primary-500 mt-1.5 shrink-0"></span>
                                                    <span>
                                                        Voucher de Pago por <strong class="text-primary-700">@pay.Concept</strong>@(string.IsNullOrWhiteSpace(pay.Code) ? "" : $" (cod. {pay.Code})") por el monto de <strong class="text-primary-700">s/. @pay.Amount.ToString("N2")</strong>
                                                    </span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-[11px] text-ink-400 italic">Sin requisitos configurados.</p>
                                    }
                                </div>

                                @if (mod.EntryRequirements.Any())
                                {
                                    <div class="rounded-md ring-1 ring-secondary-100 bg-secondary-50/40 p-4">
                                        <div class="flex items-center gap-2 mb-3 pb-2 border-b border-secondary-100">
                                            <span class="w-7 h-7 rounded-md bg-secondary-100 flex items-center justify-center shrink-0">
                                                <i class="ti ti-circle-check text-secondary-600 text-[11px]"></i>
                                            </span>
                                            <p class="text-xs font-bold text-secondary-700 uppercase tracking-[0.14em]">Requisitos en Caso de Ingreso</p>
                                        </div>
                                        <ul class="space-y-2">
                                            @foreach (var req in mod.EntryRequirements)
                                            {
                                                <li class="flex gap-2 text-xs sm:text-[13px] text-ink-700 leading-relaxed">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary-500 mt-1.5 shrink-0"></span>
                                                    <span>@req</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 flex items-start gap-3 bg-secondary-50 ring-1 ring-secondary-200 rounded-md px-4 sm:px-5 py-4">
                <i class="ti ti-info-circle text-secondary-600 text-sm mt-0.5 shrink-0"></i>
                <p class="text-xs sm:text-[13px] text-secondary-800 leading-relaxed">
                    Para mayor información sobre los requisitos comunícate con la <strong>Dirección de Admisión</strong> de la UNAMAD.
                    Los documentos deben ser presentados dentro de los plazos establecidos en el cronograma.
                </p>
            </div>
        }
    </div>
</section>

<style>
    .mod-card.is-open {
        box-shadow:
            0 0 0 1px #f54477,
            0 8px 28px -12px rgba(245, 68, 119, 0.25);
    }
    .mod-card.is-open > .mod-header { background-color: #fef2f5; }
    .mod-card.is-open .mod-icon {
        background-color: #f54477;
        box-shadow: 0 0 0 1px #f31a5b;
    }
    .mod-card.is-open .mod-icon i { color: #ffffff; }
    .mod-card.is-open .mod-title  { color: #d10e49; }
    .mod-card.is-open .mod-chevron { color: #f54477; }
</style>

<script>
    function toggleMod(id) {
        const target = document.getElementById('mod-' + id);
        if (!target) return;
        const wasOpen = target.classList.contains('is-open');

        document.querySelectorAll('.mod-card').forEach(el => {
            el.classList.remove('is-open');
            const btn = el.querySelector('.mod-header');
            if (btn) btn.setAttribute('aria-expanded', 'false');
            const content = el.querySelector('.mod-content');
            if (content) content.classList.add('hidden');
        });

        if (!wasOpen) {
            target.classList.add('is-open');
            const btn = target.querySelector('.mod-header');
            if (btn) btn.setAttribute('aria-expanded', 'true');
            const content = target.querySelector('.mod-content');
            if (content) content.classList.remove('hidden');
        }
    }
</script>
