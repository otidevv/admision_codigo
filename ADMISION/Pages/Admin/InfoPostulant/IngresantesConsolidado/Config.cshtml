@model ADMISION.Models.ViewModels.Admin.ConsolidadoConfigViewModel
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Configuración del Consolidado";
}

<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2 flex-wrap">
        <a href="/admin/info-postulant" class="hover:text-primary-600 transition-colors">Información del postulante</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/info-postulant/ingresantes_consolidado" class="hover:text-primary-600 transition-colors">Consolidado</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Configuración</span>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="eyebrow">Consolidado</div>
            <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
                Configuración de <span class="font-serif font-normal text-primary-600">consolidado</span>
            </h1>
            <p class="text-ink-500 text-sm mt-1">Definir índices de codificación por tipo de postulante o carrera para el período académico</p>
        </div>
        <a href="/admin/info-postulant/ingresantes_consolidado"
           class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Volver al consolidado
        </a>
    </div>
</section>

@if (TempData["Success"] != null)
{
    <div class="fade-up mb-4 p-3 rounded-md bg-emerald-50 ring-1 ring-emerald-200 text-emerald-700 text-sm font-semibold flex items-center gap-2">
        <i class="ti ti-circle-check"></i><span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="fade-up mb-4 p-3 rounded-md bg-rose-50 ring-1 ring-rose-200 text-rose-700 text-sm font-semibold flex items-center gap-2">
        <i class="ti ti-alert-circle"></i><span>@TempData["Error"]</span>
    </div>
}

<!-- Selector de período -->
<div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-calendar text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Período Académico</h2>
            <p class="text-[11.5px] text-ink-500">Seleccione el período para configurar los índices</p>
        </div>
    </div>
    <div class="p-4 sm:p-6">
        <form asp-controller="InfoPostulant" asp-action="ConsolidadoConfig" method="get" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
                <div class="sm:col-span-2">
                    @{
                        var termOptions = Model.Terms.Select(t => new { id = t.Id, name = t.Name });
                    }
                    <partial name="_CustomSelect" model='new { Id = "termSelect", Name = "SelectedTermId", Label = "Período Académico", Placeholder = "-- Seleccionar período --", Required = true, Options = termOptions, SelectedValue = Model.SelectedTermId?.ToString() ?? "" }' />
                </div>
                <div>
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors">
                        <i class="ti ti-search text-xs"></i> Cargar configuración
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedTermId.HasValue)
{
    <!-- Formulario para agregar nueva entrada -->
    <div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 inline-flex items-center justify-center">
                <i class="ti ti-plus text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Agregar configuración</h2>
                <p class="text-[11.5px] text-ink-500">Asociar un índice con una descripción y un tipo de postulante o carrera</p>
            </div>
        </div>
        <div class="p-4 sm:p-6">
            <form asp-controller="InfoPostulant" asp-action="SaveConsolidadoConfig" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SelectedTermId" value="@Model.SelectedTermId" />

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-ink-600 dark:text-ink-300 mb-1">Índice</label>
                        <input name="Index" type="number" min="1" required
                               class="form-input w-full" placeholder="1, 2, 3..." />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-ink-600 dark:text-ink-300 mb-1">Descripción</label>
                        <input name="Description" type="text" required
                               class="form-input w-full" placeholder="Ej: Ingresante por admisión" />
                    </div>
                    <div>
                        @{
                            var careerOptions = Model.Careers.Select(c => new { id = c.Id.ToString(), name = c.Name });
                        }
                        <partial name="_CustomSelect" model='new { Id = "careerSelect", Name = "CareerId", Label = "Carrera (CEPRE)", Placeholder = "-- Opcional --", Options = careerOptions, SelectedValue = "" }' />
                    </div>
                    <div>
                        @{
                            var modalityOptions = Model.Modalities.Select(m => new { id = m.Id.ToString(), name = m.Name });
                        }
                        <partial name="_CustomSelect" model='new { Id = "modalitySelect", Name = "ModalityId", Label = "Modalidad", Placeholder = "-- Opcional --", Options = modalityOptions, SelectedValue = "" }' />
                    </div>
                    <div>
                        @{
                            var typeModalityOptions = Model.TypeModalities.Select(tm => new { id = tm.Id.ToString(), name = tm.Name });
                        }
                        <partial name="_CustomSelect" model='new { Id = "typeModalitySelect", Name = "TypeModalityId", Label = "Tipo de Modalidad", Placeholder = "-- Opcional --", Options = typeModalityOptions, SelectedValue = "" }' />
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition-colors">
                        <i class="ti ti-plus text-xs"></i> Agregar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de configuraciones existentes -->
    <div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-list text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Configuración actual</h2>
                <p class="text-[11.5px] text-ink-500">@Model.Configurations.Count registro(s) configurado(s)</p>
            </div>
        </div>

        @if (Model.Configurations.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="atlas w-full text-xs">
                    <thead>
                        <tr>
                            <th class="text-center">Índice</th>
                            <th>Descripción</th>
                            <th>Carrera</th>
                            <th>Modalidad</th>
                            <th>Tipo de Modalidad</th>
                            <th>Creado por</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cfg in Model.Configurations.OrderBy(c => c.Index))
                        {
                            <tr>
                                <td class="text-center font-mono font-bold text-primary-600">@cfg.Index</td>
                                <td class="font-semibold">@cfg.Description</td>
                                <td>@(cfg.Career?.Name ?? "—")</td>
                                <td>@(cfg.Modality?.Name ?? "—")</td>
                                <td>@(cfg.TypeModality?.Name ?? "—")</td>
                                <td class="text-ink-500">@cfg.CreatedBy</td>
                                <td class="text-center">
                                    <form asp-controller="InfoPostulant" asp-action="DeleteConsolidadoConfig" asp-route-id="@cfg.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="SelectedTermId" value="@Model.SelectedTermId" />
                                        <button type="submit"
                                                onclick="return confirm('¿Eliminar esta configuración?')"
                                                class="inline-flex items-center gap-1 px-3 py-1 rounded-md bg-rose-50 text-rose-600 text-[11px] font-semibold hover:bg-rose-100 transition-colors">
                                            <i class="ti ti-trash text-[10px]"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-8 text-center text-ink-400">
                <i class="ti ti-settings-off text-3xl mb-2 block"></i>
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em]">Sin configuración para este período</p>
                <p class="text-xs text-ink-400 mt-1">Agregue entradas usando el formulario superior</p>
            </div>
        }
    </div>
}
