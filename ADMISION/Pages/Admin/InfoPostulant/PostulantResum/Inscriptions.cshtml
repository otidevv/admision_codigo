@model List<ADMISION.ENTITIES.Models.Postulante.Inscription>
@using ADMISION.ENTITIES.Constants

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";

    var postulant = ViewBag.Postulant as ADMISION.ENTITIES.Models.Postulant.Postulant;
    var user = postulant?.User;
    var fullName = $"{user?.FirstNameFather} {user?.FirstNameMother}, {user?.Name}";
    var postulantId = postulant?.Id;

    ViewData["Title"] = "Inscripciones - " + fullName;

    string GetStateBadge(string state) => state switch {
        AppConstants.InscripcionState.Aprobado => "badge b-green",
        AppConstants.InscripcionState.Observado => "badge b-amber",
        AppConstants.InscripcionState.Rechazado => "badge b-red",
        AppConstants.InscripcionState.Retirado => "badge b-gray",
        _ => "badge b-blue"
    };

    var groupedInscriptions = Model
        .GroupBy(i => i.Modality?.Term?.Name ?? "Sin Periodo")
        .OrderByDescending(g => g.Key)
        .ToList();
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2 flex-wrap">
        <a href="/admin/info-postulant/postulant/postulant-resum" class="hover:text-primary-600 transition-colors">Búsqueda</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/info-postulant/postulant/postulant-resum/@postulantId" class="hover:text-primary-600 transition-colors truncate max-w-[200px]">Expediente</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Inscripciones</span>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="eyebrow">Expediente del postulante</div>
            <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
                Historial de <span class="font-serif font-normal text-primary-600">inscripciones</span>
            </h1>
            <p class="text-ink-500 text-sm mt-1">@fullName</p>
        </div>
        <a href="/admin/info-postulant/postulant/postulant-resum/@postulantId"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Volver al expediente
        </a>
    </div>
</section>

@if (!Model.Any())
{
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="py-14 text-center">
            <i class="ti ti-clipboard-list text-4xl text-ink-300 mb-3 block"></i>
            <p class="text-ink-400 text-sm font-medium">No se encontraron inscripciones registradas.</p>
        </div>
    </section>
}
else
{
    <div class="space-y-5">
        @foreach (var group in groupedInscriptions)
        {
            <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
                <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
                    <span class="w-9 h-9 rounded-md bg-secondary-100 dark:bg-secondary-500/10 text-secondary-600 inline-flex items-center justify-center">
                        <i class="ti ti-calendar text-sm"></i>
                    </span>
                    <div class="flex-1">
                        <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Periodo: @group.Key</h2>
                        <p class="text-[11.5px] text-ink-500">Inscripciones registradas en este periodo</p>
                    </div>
                    <span class="badge b-secondary">@group.Count() inscripción(es)</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-[12.5px]">
                        <thead>
                            <tr class="text-ink-400 border-b border-ink-200/60 dark:border-ink-800/60">
                                <th class="text-left px-4 sm:px-5 py-3 font-semibold">Código</th>
                                <th class="text-left px-4 py-3 font-semibold">Carrera</th>
                                <th class="text-left px-4 py-3 font-semibold">Modalidad</th>
                                <th class="text-left px-4 py-3 font-semibold">Tipo</th>
                                <th class="text-center px-4 py-3 font-semibold">Estado</th>
                                <th class="text-left px-4 py-3 font-semibold">Fecha</th>
                                <th class="text-center px-4 sm:px-5 py-3 font-semibold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group)
                            {
                                <tr class="border-b border-ink-100/60 dark:border-ink-800/40 hover:bg-ink-50/40 dark:hover:bg-ink-800/20 transition-colors">
                                    <td class="px-4 sm:px-5 py-3">
                                        <span class="font-mono font-semibold text-ink-800 dark:text-ink-100 text-[11.5px]">@item.CodePostulant</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="font-medium text-ink-800 dark:text-ink-100">@(item.Career?.Name ?? "—")</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-ink-600 dark:text-ink-300">@(item.Modality?.Name ?? "—")</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-ink-500 dark:text-ink-400 text-[11px]">@(item.TypeModality?.Name ?? "—")</span>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="@GetStateBadge(item.State) text-[10px]">@item.State</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-ink-500 dark:text-ink-400 tabular-nums text-[11.5px]">@item.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td class="px-4 sm:px-5 py-3">
                                        <div class="flex items-center justify-center gap-1.5">
                                            @if (item.State == AppConstants.InscripcionState.Aprobado)
                                            {
                                                <a href="/inscripcion/@item.Id/constancia?inline=true" target="_blank"
                                                   class="inline-flex items-center justify-center w-8 h-8 rounded-md ring-1 ring-sky-200 dark:ring-sky-500/30 text-sky-700 dark:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-500/10 transition-colors"
                                                   title="Ver constancia de inscripcion">
                                                    <i class="ti ti-file-download text-[11px]"></i>
                                                </a>
                                            }
                                            <a href="/admin/info-postulant/postulant/postulant-resum/@postulantId/inscriptions/@item.Id/validate"
                                               class="inline-flex items-center justify-center w-8 h-8 rounded-md ring-1 ring-emerald-200 dark:ring-emerald-500/30 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-500/10 transition-colors"
                                               title="Validar archivos">
                                                <i class="ti ti-clipboard-check text-[11px]"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
}
