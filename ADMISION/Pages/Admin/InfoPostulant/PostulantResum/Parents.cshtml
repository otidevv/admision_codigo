@model IReadOnlyList<ADMISION.ENTITIES.Models.Postulant.Parent>

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    var postulant = ViewBag.Postulant as ADMISION.ENTITIES.Models.Postulant.Postulant;
    var user = postulant?.User;
    var fullName = $"{user?.FirstNameFather} {user?.FirstNameMother}, {user?.Name}";
    var postulantId = postulant?.Id;

    ViewData["Title"] = "Apoderado - " + fullName;
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2 flex-wrap">
        <a href="/admin/info-postulant/postulant/postulant-resum" class="hover:text-primary-600 transition-colors">Búsqueda</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/info-postulant/postulant/postulant-resum/@postulantId" class="hover:text-primary-600 transition-colors truncate max-w-[200px]">Expediente</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Apoderado</span>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="eyebrow">Expediente del postulante</div>
            <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
                Datos del <span class="font-serif font-normal text-primary-600">apoderado</span>
            </h1>
            <p class="text-ink-500 text-sm mt-1">@fullName</p>
        </div>
        <a href="/admin/info-postulant/postulant/postulant-resum/@postulantId"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Volver al expediente
        </a>
    </div>
</section>

@if (Model.Any())
{
    <div class="space-y-4">
        @foreach (var p in Model)
        {
            <article class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft p-5">
                <div class="flex items-start justify-between gap-3 mb-4 flex-wrap">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 flex items-center justify-center flex-shrink-0">
                            <i class="ti ti-user-shield"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">Apoderado registrado</p>
                            <h2 class="text-base font-semibold text-ink-900 dark:text-ink-100 tracking-tight">@p.FullName</h2>
                        </div>
                    </div>
                    <span class="badge b-amber">
                        <i class="ti ti-calendar mr-1"></i> Registrado el @p.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">
                        <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">Nombres</p>
                        <p class="text-sm font-semibold text-ink-900 dark:text-ink-100 mt-0.5">@p.Name</p>
                    </div>
                    <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">
                        <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">Ap. paterno</p>
                        <p class="text-sm font-semibold text-ink-900 dark:text-ink-100 mt-0.5">@p.FirstNameFather</p>
                    </div>
                    <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">
                        <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">Ap. materno</p>
                        <p class="text-sm font-semibold text-ink-900 dark:text-ink-100 mt-0.5">@p.FirstNameMother</p>
                    </div>
                    <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">
                        <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">@p.TypeDocument</p>
                        <p class="text-sm font-semibold text-ink-900 dark:text-ink-100 mt-0.5 font-mono tabular-nums">@p.NumberDocument</p>
                    </div>
                    <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">
                        <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">Teléfono</p>
                        <p class="text-sm font-semibold text-ink-900 dark:text-ink-100 mt-0.5 font-mono tabular-nums">@p.Phone</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Email))
                    {
                        <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">
                            <p class="text-[10px] font-bold tracking-[0.14em] uppercase text-ink-400">Correo</p>
                            <p class="text-sm font-semibold text-ink-900 dark:text-ink-100 mt-0.5 truncate">@p.Email</p>
                        </div>
                    }
                </div>

                <div class="mt-4 pt-3 border-t border-ink-200/60 dark:border-ink-800/60 flex items-center gap-2 text-[11px] text-ink-500 flex-wrap">
                    <i class="ti ti-info-circle text-[12px]"></i>
                    <span>Registrado por <strong>@(p.CreatedBy ?? "—")</strong> el @p.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                    @if (p.UpdatedAt.HasValue)
                    {
                        <span class="text-ink-400">·</span>
                        <span>Actualizado el @p.UpdatedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft p-10 text-center">
        <div class="w-14 h-14 rounded-md bg-ink-100 dark:bg-ink-800 text-ink-400 flex items-center justify-center mx-auto mb-3">
            <i class="ti ti-user-shield text-2xl"></i>
        </div>
        <h3 class="text-ink-800 dark:text-ink-100 font-semibold tracking-tight">Sin apoderado registrado</h3>
        <p class="text-ink-500 text-[12.5px] mt-1 max-w-md mx-auto leading-relaxed">
            Este postulante no requirió apoderado al momento de inscribirse, o el dato no fue proporcionado. La sección sólo aplica cuando el postulante es menor de edad.
        </p>
    </div>
}
