        <!-- Controls Section -->
        <div class="w-full md:w-96 flex flex-col justify-center animate-in slide-in-from-right duration-500">
            <div class="bg-white/5 backdrop-blur-2xl rounded-md p-8 ring-1 ring-white/10">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-md bg-primary-500/20 flex items-center justify-center text-primary-300">
                        <i class="ti ti-adjustments-horizontal"></i>
                    </div>
                    <h4 class="text-white font-semibold tracking-tight">Ajustes de imagen</h4>
                </div>

                <div class="space-y-5">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <label class="text-[10px] font-bold text-white/50 uppercase tracking-[0.16em]">Brillo</label>
                            <span id="briVal" class="text-xs font-mono font-bold text-primary-300 tabular-nums">100%</span>
                        </div>
                        <input type="range" id="briRange" min="50" max="150" value="100"
                               class="w-full h-1.5 bg-white/10 rounded-full appearance-none cursor-pointer accent-primary-500">
                    </div>
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <label class="text-[10px] font-bold text-white/50 uppercase tracking-[0.16em]">Contraste</label>
                            <span id="conVal" class="text-xs font-mono font-bold text-primary-300 tabular-nums">100%</span>
                        </div>
                        <input type="range" id="conRange" min="50" max="150" value="100"
                               class="w-full h-1.5 bg-white/10 rounded-full appearance-none cursor-pointer accent-primary-500">
                    </div>
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <label class="text-[10px] font-bold text-white/50 uppercase tracking-[0.16em]">Saturación</label>
                            <span id="satVal" class="text-xs font-mono font-bold text-primary-300 tabular-nums">100%</span>
                        </div>
                        <input type="range" id="satRange" min="0" max="200" value="100"
                               class="w-full h-1.5 bg-white/10 rounded-full appearance-none cursor-pointer accent-primary-500">
                    </div>
                </div>

                <div class="mt-10 space-y-3">
                    <button id="btnCapture"
                            class="w-full h-14 bg-primary-500 hover:bg-primary-600 text-white rounded-md font-bold text-sm hover:-translate-y-0.5 active:scale-95 transition-all flex items-center justify-center gap-3 tracking-[0.08em] uppercase">
                        <i class="ti ti-camera"></i> Capturar foto
                    </button>
                    <button onclick="PhotoCapture.resetFilters()"
                            class="w-full py-3 text-white/50 hover:text-white text-[10px] font-bold uppercase tracking-[0.16em] transition-colors">
                        <i class="ti ti-arrow-back-up mr-2"></i> Restablecer ajustes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

</div><!-- /main -->
</div><!-- /grid -->

<form id="fileReplaceForm" method="post" enctype="multipart/form-data" class="hidden">
    @Html.AntiForgeryToken()
    <input type="file" id="replaceFileInput" name="newFile" accept=".pdf,.jpg,.jpeg,.png,.gif,.webp" />
</form>

@* Modales de voucher externo asociado *@
@foreach (var file in Model.Files.Where(f => f.HasExternalAssociation && f.ExternalVoucher != null))
{
    var voucher = file.ExternalVoucher!;
    <div id="validationVoucherModal-@file.Id" class="adm-modal" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="adm-modal__overlay" data-modal-close></div>
        <div class="adm-modal__card adm-modal__card--md">
            <header class="adm-modal__header">
                <div class="min-w-0">
                    <div class="eyebrow">Pago externo asociado</div>
                    <h3 class="adm-modal__title mt-1">@voucher.SerialVoucher</h3>
                    <p class="adm-modal__subtitle">@voucher.FullName</p>
                </div>
                <button type="button" class="adm-modal__close" data-modal-close aria-label="Cerrar">
                    <i class="ti ti-x"></i>
                </button>
            </header>
            <div class="adm-modal__body">
                <div class="rounded-lg bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-4 mb-4">
                    <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
                        <div>
                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Usuario</span>
                            <p class="font-mono text-ink-900 dark:text-ink-100">@voucher.UserName</p>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Nombre completo</span>
                            <p class="text-ink-900 dark:text-ink-100">@voucher.FullName</p>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Serie del voucher</span>
                            <p class="font-mono text-ink-900 dark:text-ink-100">@voucher.SerialVoucher</p>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Fecha de consulta</span>
                            <p class="font-mono text-ink-900 dark:text-ink-100">@voucher.QueriedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>

                @if (voucher.Payments != null && voucher.Payments.Count > 0)
                {
                    <div class="space-y-4">
                        @foreach (var detail in voucher.Payments)
                        {
                            <div class="rounded-lg bg-white dark:bg-ink-800/60 ring-1 ring-ink-200/60 dark:ring-ink-700/60 overflow-hidden">
                                <div class="bg-primary/5 dark:bg-primary-500/10 px-4 py-2.5 border-b border-ink-200/40 dark:border-ink-700/40 flex items-center justify-between">
                                    <p class="text-sm font-semibold text-ink-900 dark:text-ink-100">@detail.Description</p>
                                    <div class="flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(detail.Acronym))
                                        {
                                            <span class="badge b-primary text-[9px]">@detail.Acronym</span>
                                        }
                                        @if (detail.IsBankPayment)
                                        {
                                            <span class="badge b-teal text-[9px]"><i class="ti ti-building-bank text-[8px]"></i> Banco</span>
                                        }
                                        @(detail.Status == 1 ? Html.Raw("<span class=\"badge b-green text-[9px]\">Activo</span>") : Html.Raw("<span class=\"badge b-gray text-[9px]\">Inactivo</span>"))
                                    </div>
                                </div>
                                <div class="p-4 grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-3 text-sm">
                                    @if (!string.IsNullOrEmpty(detail.TermName))
                                    {
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Periodo / Modalidad</span>
                                            <p class="text-ink-900 dark:text-ink-100">@detail.TermName</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(detail.TypeUser))
                                    {
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Tipo de usuario</span>
                                            <p class="text-ink-900 dark:text-ink-100">@detail.TypeUser</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(detail.Name))
                                    {
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Nombre concepto</span>
                                            <p class="text-ink-900 dark:text-ink-100">@detail.Name</p>
                                        </div>
                                    }
                                    <div>
                                        <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Subtotal</span>
                                        <p class="font-mono tabular-nums text-ink-700 dark:text-ink-200">S/ @detail.SubTotal.ToString("F2")</p>
                                    </div>
                                    <div>
                                        <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Descuento</span>
                                        <p class="font-mono tabular-nums text-ink-700 dark:text-ink-200">S/ @detail.Discount.ToString("F2")</p>
                                    </div>
                                    <div>
                                        <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Total</span>
                                        <p class="font-mono tabular-nums font-bold text-emerald-600">S/ @detail.Total.ToString("F2")</p>
                                    </div>
                                    <div>
                                        <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Cantidad</span>
                                        <p class="font-mono tabular-nums text-ink-700 dark:text-ink-200">@detail.Quantity</p>
                                    </div>
                                    @if (detail.PaymentDate.HasValue)
                                    {
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Fecha de pago</span>
                                            <p class="font-mono text-ink-900 dark:text-ink-100">@detail.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(detail.Cashier))
                                    {
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Cajero</span>
                                            <p class="text-ink-900 dark:text-ink-100">@detail.Cashier</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(detail.CreatedBy))
                                    {
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Registrado por</span>
                                            <p class="text-ink-900 dark:text-ink-100">@detail.CreatedBy</p>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(detail.AmountInWords))
                                {
                                    <div class="px-4 py-2.5 bg-ink-50/60 dark:bg-ink-800/40 border-t border-ink-200/40 dark:border-ink-700/40">
                                        <span class="text-[10px] uppercase tracking-widest font-semibold text-ink-400">Monto en letras: </span>
                                        <span class="text-[12px] text-ink-700 dark:text-ink-200 italic">@detail.AmountInWords</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-ink-400 text-center py-4">Sin detalle de pagos</p>
                }
            </div>
            <footer class="adm-modal__footer">
                <button type="button" data-modal-close
                        class="btn-soft inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold transition-all">
                    Cerrar
                </button>
            </footer>
        </div>
    </div>
}

