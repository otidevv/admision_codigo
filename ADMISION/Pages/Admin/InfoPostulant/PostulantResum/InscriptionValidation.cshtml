@section Scripts {
    <script src="~/js/admin/info-postulant/postulant-resum/unified-expediente.js" asp-append-version="true"></script>
    <script src="~/js/admin/postulants/photo-capture.js" asp-append-version="true"></script>
    <script src="~/js/admin/postulants/finger-print.js" asp-append-version="true"></script>
    <script>
        (function () {
            const postulantId = '@postulantId';
            const inscriptionId = '@inscriptionId';

            PhotoCapture.init(postulantId);
            FingerCapture.init(postulantId);

            // ── Academic data refresh ──
            function showLoader() { document.getElementById('academicLoader')?.classList.remove('hidden'); }
            function hideLoader() { document.getElementById('academicLoader')?.classList.add('hidden'); }
            function showError(msg) { const el = document.getElementById('academicCardError'); if (el) { el.textContent = msg; el.classList.remove('hidden'); } }
            function hideError() { document.getElementById('academicCardError')?.classList.add('hidden'); }
            function showEmpty() { document.getElementById('academicCardEmpty')?.classList.remove('hidden'); }
            function hideEmpty() { document.getElementById('academicCardEmpty')?.classList.add('hidden'); }
            function showData() { document.getElementById('academicCardData')?.classList.remove('hidden'); }
            function hideData() { document.getElementById('academicCardData')?.classList.add('hidden'); }

            function renderRecords(records) {
                const container = document.querySelector('#academicCardContent');
                if (!container) return;
                if (!records || records.length === 0) { container.innerHTML = ''; return; }
                let html = '';
                records.forEach(function (r) {
                    const credits = (r.totalCreditsApproved || 0).toFixed(2);
                    const queried = r.queriedAt ? new Date(r.queriedAt).toLocaleString('es-PE') : '';
                    html += '<div class="rounded-lg bg-ink-50/60 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-800 p-3">' +
                        '<div class="flex items-center justify-between mb-2">' +
                        '<span class="text-xs font-bold uppercase tracking-[0.12em] text-primary-600">' + (r.careerName || '') + '</span>' +
                        '<span class="badge b-emerald text-[10px]">' + credits + ' creditos</span></div>' +
                        '<p class="text-sm font-semibold text-ink-900 dark:text-ink-100">' + (r.paternalSurname || '') + ' ' + (r.maternalSurname || '') + ', ' + (r.name || '') + '</p>' +
                        '<p class="text-xs text-ink-500 mt-1">' + (r.facultyName || '') + '</p>' +
                        (r.email ? '<p class="text-xs text-ink-400 mt-1"><i class="ti ti-mail mr-1"></i>' + r.email + '</p>' : '') +
                        '<p class="text-[10px] text-ink-400 mt-2 font-mono"><i class="ti ti-clock mr-0.5"></i> ' + queried + '</p></div>';
                });
                container.innerHTML = html;
            }

            document.getElementById('refreshAcademicBtn')?.addEventListener('click', function () {
                showLoader(); hideError();
                fetch('/admin/info-postulant/postulant/postulant-resum/' + postulantId + '/external-academic/refresh')
                    .then(function(r) { return r.json(); })
                    .then(function(result) {
                        hideLoader();
                        var hasData = result.success && result.data && result.data.length > 0;
                        if (hasData) { renderRecords(result.data); hideEmpty(); showData(); }
                        else { hideData(); showEmpty(); }
                        if (!result.success && result.message && result.message !== 'sin_api') showError(result.message);
                    })
                    .catch(function() { hideLoader(); showError('Error de red al consultar datos academicos.'); });
            });

            // ── Sidebar navigation ──
            var sections = ['personales', 'postulacion', 'archivos', 'biometria'];
            var navItems = document.querySelectorAll('.expediente-nav-item');

            function setActiveNav(id) {
                navItems.forEach(function (n) { n.classList.toggle('active', n.dataset.section === id); });
            }

            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (e.isIntersecting) setActiveNav(e.target.id);
                    });
                }, { rootMargin: '-20% 0px -70% 0px' });
                sections.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) observer.observe(el);
                });
            }

            navItems.forEach(function (n) {
                n.addEventListener('click', function (e) {
                    e.preventDefault();
                    var el = document.getElementById(n.dataset.section);
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });
        })();
    </script>
}
