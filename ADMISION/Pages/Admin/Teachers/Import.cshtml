@{
    ViewData["Title"] = "Importar Docentes";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin" class="hover:text-primary-600 transition-colors">Admin</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/docentes" class="hover:text-primary-600 transition-colors">Docentes</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Importar</span>
    </div>
    <div class="eyebrow">Gestión académica</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Importar docentes desde <span class="font-serif font-normal text-primary-600">Excel</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Carga masiva de docentes a partir de un archivo .xlsx.</p>
</section>

<form id="importTeachersForm" asp-controller="Teachers" asp-action="Import" method="post" enctype="multipart/form-data" class="space-y-5 max-w-3xl">
    <!-- Card: Instrucciones -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-list-check text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Instrucciones</h2>
                <p class="text-[11.5px] text-ink-500">Estructura requerida del archivo Excel</p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <p class="text-sm text-ink-600 dark:text-ink-300 mb-3">El archivo Excel debe contener las siguientes columnas en el orden exacto:</p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-ink-700 dark:text-ink-200 bg-ink-50 dark:bg-ink-800/40 ring-1 ring-ink-200/60 dark:ring-ink-700/60 p-4 rounded-md">
                <li class="flex items-center gap-2"><span class="badge b-gray">1</span> DNI</li>
                <li class="flex items-center gap-2"><span class="badge b-gray">2</span> Apellido Paterno</li>
                <li class="flex items-center gap-2"><span class="badge b-gray">3</span> Apellido Materno</li>
                <li class="flex items-center gap-2"><span class="badge b-gray">4</span> Nombres</li>
                <li class="flex items-center gap-2"><span class="badge b-gray">5</span> Especialidad</li>
                <li class="flex items-center gap-2"><span class="badge b-gray">6</span> Grado Académico</li>
                <li class="flex items-center gap-2"><span class="badge b-gray">7</span> Tipo Docente (Nombrado / Contratado / Auxiliar)</li>
            </ul>

            <div class="mt-4 p-3 bg-amber-50 dark:bg-amber-500/10 ring-1 ring-amber-200/60 dark:ring-amber-500/20 rounded-md">
                <p class="text-[12.5px] text-amber-800 dark:text-amber-300 flex items-center gap-2">
                    <i class="ti ti-alert-triangle text-xs"></i>
                    Si el DNI ya existe en el sistema, se asociará automáticamente al usuario existente. Si el DNI es nuevo, se creará un nuevo registro de usuario.
                </p>
            </div>
        </div>
    </section>

    <!-- Card: Archivo Excel -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-file-spreadsheet text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Archivo Excel</h2>
                <p class="text-[11.5px] text-ink-500">Formato .xlsx</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>
            }

            <div class="form-input-wrapper border-2 border-dashed border-ink-200 dark:border-ink-700 rounded-md px-6 pt-6 pb-7 hover:border-primary-500 transition-colors bg-ink-50/40 dark:bg-ink-800/30">
                <div class="flex flex-col items-center text-center space-y-2">
                    <i id="file-icon" class="ti ti-file-spreadsheet text-4xl text-emerald-500 mb-2"></i>
                    <div id="file-info" class="hidden mb-2">
                        <span id="file-name" class="block text-sm font-semibold text-ink-900 dark:text-ink-100"></span>
                        <span id="file-size" class="block text-xs text-ink-500"></span>
                    </div>
                    <div class="flex text-sm text-ink-600 dark:text-ink-300 justify-center">
                        <label for="excelFile"
                               class="relative cursor-pointer inline-flex items-center gap-2 px-4 py-2 rounded-md bg-white dark:bg-ink-800 ring-soft text-primary-600 font-semibold hover:bg-primary-50 dark:hover:bg-primary-500/10 transition-all">
                            <i class="ti ti-folder-open text-xs"></i>
                            <span>Seleccionar archivo .xlsx</span>
                            <input id="excelFile" name="excelFile" type="file" accept=".xlsx" class="sr-only" onchange="handleFileSelect(this)" />
                        </label>
                    </div>
                    <p class="text-xs text-ink-500">Solo archivos .xlsx</p>
                </div>
            </div>
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a href="/admin/docentes"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-cloud-upload text-xs"></i> Iniciar importación
        </button>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin/teachers/import.js" asp-append-version="true"></script>
}
