@model ADMISION.ENTITIES.Models.EconomicManagement.PaymentCode

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    var isNew = Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "Crear Código de Pago" : "Editar Código de Pago";
    var termOptions = ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.TermId)
        .Select(i => new { id = i.Value, name = i.Text });
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/economic-management" class="hover:text-primary-600 transition-colors">Gestión económica</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a asp-action="Index" class="hover:text-primary-600 transition-colors">Códigos de Pago</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">@(isNew ? "Nuevo" : "Editar")</span>
    </div>
    <div class="eyebrow">Conceptos de recaudación</div>
    @{
        var heroVerb = isNew ? "Crear" : "Editar";
        var heroAccent = isNew ? "código de pago" : Model.Code;
    }
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        @heroVerb <span class="font-serif font-normal text-primary-600">@heroAccent</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Define el código, descripción y las asociaciones con modalidades y montos.</p>
</section>

<form asp-action="Save" method="post" class="space-y-5 max-w-4xl">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- Card: Datos del código -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-receipt text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos del código</h2>
                <p class="text-[11.5px] text-ink-500">Identificación del concepto de recaudación y periodo académico</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-4">
                <div>
                    <partial name="_FormInput" model='@(new {
                        Id = "Code", Name = "Code",
                        Label = "Código de recaudación", Required = true,
                        Placeholder = "Ej: 00123",
                        Value = Model.Code,
                        IconLeft = "ti-barcode",
                        Error = ViewData.ModelState["Code"]?.Errors.FirstOrDefault()?.ErrorMessage
                    })' />
                    <span asp-validation-for="Code" class="text-xs text-rose-600"></span>
                </div>

                <div>
                    <partial name="_CustomSelect" model='new { Id = "TermId", Name = "TermId", Label = "Periodo académico", Placeholder = "Seleccione periodo", Required = true, Options = termOptions, SelectedValue = Model.TermId != Guid.Empty ? Model.TermId.ToString() : "" }' />
                    <span asp-validation-for="TermId" class="text-xs text-rose-600"></span>
                </div>
            </div>

            <div>
                <partial name="_FormInput" model='@(new {
                    Id = "Description", Name = "Description",
                    Label = "Descripción / Concepto", Required = true,
                    Placeholder = "Ej: Inscripción Examen Ordinario",
                    Value = Model.Description,
                    IconLeft = "ti-file-text",
                    Error = ViewData.ModelState["Description"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />
                <span asp-validation-for="Description" class="text-xs text-rose-600"></span>
            </div>
        </div>
    </section>

    <!-- Card: Asociaciones y montos -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center justify-between gap-3 rounded-t-md">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-md bg-secondary-50 dark:bg-secondary-500/10 text-secondary-600 inline-flex items-center justify-center">
                    <i class="ti ti-coin text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Asociaciones y montos</h2>
                    <p class="text-[11.5px] text-ink-500">Define el monto por combinación de modalidad y tipo</p>
                </div>
            </div>
            <button type="button" onclick="addAssociation()"
                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 ring-1 ring-primary-200 dark:ring-primary-500/30 hover:bg-primary-100 dark:hover:bg-primary-500/20 text-xs font-semibold transition-colors">
                <i class="ti ti-plus text-[10px]"></i> Añadir asociación
            </button>
        </div>

        <div class="p-4 sm:p-5">
            <div class="overflow-x-auto rounded-md ring-1 ring-ink-200/60 dark:ring-ink-800/60">
                <table class="atlas w-full">
                    <thead>
                        <tr>
                            <th>Modalidad</th>
                            <th>Tipo de modalidad</th>
                            <th class="w-40 text-right">Monto (S/.)</th>
                            <th class="text-right"></th>
                        </tr>
                    </thead>
                    <tbody id="associationsContainer">
                        @if (Model.PaymentCodeModalities != null && Model.PaymentCodeModalities.Any())
                        {
                            var index = 0;
                            foreach (var item in Model.PaymentCodeModalities)
                            {
                                <tr>
                                    <td>
                                        <select name="modalities[@index].ModalityId" class="w-full h-10 rounded-md bg-white dark:bg-ink-800 ring-1 ring-ink-200 dark:ring-ink-700 px-3 text-sm text-ink-800 dark:text-ink-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                                            <option value="">-- Todas --</option>
                                            @foreach(var m in (IEnumerable<ADMISION.Services.Interfaces.CatalogOption>)ViewBag.Modalities)
                                            {
                                                <option value="@m.Id" selected="@(item.ModalityId == m.Id)">@m.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select name="modalities[@index].TypeModalityId" class="w-full h-10 rounded-md bg-white dark:bg-ink-800 ring-1 ring-ink-200 dark:ring-ink-700 px-3 text-sm text-ink-800 dark:text-ink-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                                            <option value="">-- Todos --</option>
                                            @foreach(var t in (IEnumerable<ADMISION.Services.Interfaces.TypeModalityOption>)ViewBag.TypeModalities)
                                            {
                                                <option value="@t.Id" selected="@(item.TypeModalityId == t.Id)">@t.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <div class="flex items-center gap-0 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 bg-white dark:bg-ink-800 overflow-hidden h-10 w-full">
                                            <span class="px-2.5 text-xs font-semibold text-ink-500 bg-ink-50 dark:bg-ink-900/60 h-full inline-flex items-center border-r border-ink-200 dark:border-ink-700">S/</span>
                                            <input type="number" step="0.01" min="0" name="modalities[@index].Amount" value="@item.Amount.ToString("F2")"
                                                   class="flex-1 h-full px-3 bg-transparent text-sm font-mono tabular-nums text-right text-ink-900 dark:text-ink-100 focus:outline-none" />
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <button type="button" onclick="removeRow(this)"
                                                class="inline-flex items-center justify-center w-8 h-8 rounded-md ring-1 ring-rose-200 dark:ring-rose-500/30 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors" title="Eliminar fila">
                                            <i class="ti ti-x text-xs"></i>
                                        </button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
                <div id="emptyMessage" class="py-12 text-center @(Model.PaymentCodeModalities?.Any() == true ? "hidden" : "")">
                    <i class="ti ti-coin text-4xl text-ink-300 mb-3 block"></i>
                    <p class="text-ink-400 text-sm font-medium">No hay asociaciones configuradas.</p>
                    <p class="text-ink-400 text-xs mt-1">Haz clic en "Añadir asociación" para comenzar.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Acciones -->
    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> @(isNew ? "Crear código" : "Guardar cambios")
        </button>
    </div>
</form>

<template id="rowTemplate">
    <tr>
        <td>
            <select name="modalities[INDEX].ModalityId" class="w-full h-10 rounded-md bg-white dark:bg-ink-800 ring-1 ring-ink-200 dark:ring-ink-700 px-3 text-sm text-ink-800 dark:text-ink-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                <option value="">-- Todas --</option>
                @foreach(var m in (IEnumerable<ADMISION.Services.Interfaces.CatalogOption>)ViewBag.Modalities)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </select>
        </td>
        <td>
            <select name="modalities[INDEX].TypeModalityId" class="w-full h-10 rounded-md bg-white dark:bg-ink-800 ring-1 ring-ink-200 dark:ring-ink-700 px-3 text-sm text-ink-800 dark:text-ink-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                <option value="">-- Todos --</option>
                @foreach(var t in (IEnumerable<ADMISION.Services.Interfaces.TypeModalityOption>)ViewBag.TypeModalities)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </td>
        <td>
            <div class="flex items-center gap-0 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 bg-white dark:bg-ink-800 overflow-hidden h-10 w-full">
                <span class="px-2.5 text-xs font-semibold text-ink-500 bg-ink-50 dark:bg-ink-900/60 h-full inline-flex items-center border-r border-ink-200 dark:border-ink-700">S/</span>
                <input type="number" step="0.01" min="0" name="modalities[INDEX].Amount" value="0.00"
                       class="flex-1 h-full px-3 bg-transparent text-sm font-mono tabular-nums text-right text-ink-900 dark:text-ink-100 focus:outline-none" />
            </div>
        </td>
        <td class="text-right">
            <button type="button" onclick="removeRow(this)"
                    class="inline-flex items-center justify-center w-8 h-8 rounded-md ring-1 ring-rose-200 dark:ring-rose-500/30 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors" title="Eliminar fila">
                <i class="ti ti-x text-xs"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        window.PaymentCodeEditConfig = { startIndex: @(Model.PaymentCodeModalities?.Count ?? 0) };
    </script>
    <script src="~/js/admin/economic-management/payment-codes/edit.js" asp-append-version="true"></script>
}
