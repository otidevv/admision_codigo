@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Resumen de Postulantes";
}

<!-- Page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/reportes" class="hover:text-primary-600 transition-colors">Reportes</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Resumen de Postulantes</span>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="eyebrow">Resumen general</div>
            <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
                Resumen de <span class="font-serif font-normal text-primary-600">postulantes</span>
            </h1>
            <p class="text-ink-500 text-sm mt-1">Resumen general de postulantes por periodo y modalidad.</p>
        </div>
    </div>
</section>

<!-- Placeholder content -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft py-16 text-center">
    <i class="ti ti-users text-4xl text-ink-300 mb-3 block"></i>
    <p class="text-ink-400 font-medium text-sm">Este reporte está en desarrollo.</p>
    <p class="text-ink-500 text-xs mt-1">Próximamente disponible.</p>
</section>
