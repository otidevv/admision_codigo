@model ADMISION.Models.ViewModels.Admin.CepreImportViewModel
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Importación CEPRE";
}

<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2 flex-wrap">
        <a href="/admin/dashboard" class="hover:text-primary-600 transition-colors">Inicio</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Importación CEPRE</span>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <div class="eyebrow">Administración</div>
            <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
                Importación <span class="font-serif font-normal text-primary-600">CEPRE</span>
            </h1>
            <p class="text-ink-500 text-sm mt-1">Importar resultados del examen CEPRE desde archivo Excel</p>
        </div>
    </div>
</section>

@if (TempData["Success"] != null)
{
    <input type="hidden" id="swalSuccess" value="@TempData["Success"]" />
}
@if (TempData["Error"] != null)
{
    <input type="hidden" id="swalError" value="@TempData["Error"]" />
}

@* ── Selector de período ── *@
<div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-calendar text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Seleccionar Período</h2>
            <p class="text-[11.5px] text-ink-500">Seleccione el período académico para la importación</p>
        </div>
    </div>
    <div class="p-4 sm:p-6">
        <form asp-controller="CepreImport" asp-action="Index" method="get" class="space-y-4">
            <div class="max-w-md">
                @{
                    var termOptions = Model.Terms.Select(t => new { id = t.Id, name = t.Name });
                }
                <partial name="_CustomSelect" model='new { Id = "termSelect", Name = "termId", Label = "Período Académico", Placeholder = "-- Seleccionar período --", Required = true, Options = termOptions, SelectedValue = Model.SelectedTermId?.ToString() ?? "" }' />
            </div>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors">
                <i class="ti ti-search text-xs"></i> Seleccionar
            </button>
        </form>
    </div>
</div>

@if (Model.SelectedTermId.HasValue)
{
    @* ── Estado del turno ── *@
    <div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md @(Model.CanImport ? "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600" : "bg-rose-50 dark:bg-rose-500/10 text-rose-600") inline-flex items-center justify-center">
                <i class="ti ti@(Model.CanImport ? "-check" : "-x") text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Estado de Acceso</h2>
                <p class="text-[11.5px] text-ink-500">
                    @if (Model.IsSuperAdmin)
                    {
                        <span class="badge b-primary">SuperAdmin — Acceso directo</span>
                    }
                    else if (Model.HasActiveTurn)
                    {
                        <span class="badge b-green">Turno activo — Puede importar</span>
                    }
                    else
                    {
                        <span class="badge b-rose">Sin turno activo — Contacte al administrador</span>
                    }
                </p>
            </div>
        </div>
    </div>

    @* ── Subida de archivo ── *@
    @if (Model.CanImport)
    {
        <div class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
            <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
                <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                    <i class="ti ti-upload text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Subir archivo Excel</h2>
                    <p class="text-[11.5px] text-ink-500">Formato CEPRE: DNI, apellidos, nombres, código carrera, notas, estado</p>
                </div>
            </div>
            <div class="p-4 sm:p-6">
                <form asp-controller="CepreImport" asp-action="Preview" method="post" enctype="multipart/form-data" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SelectedTermId" value="@Model.SelectedTermId" />

                    <partial name="_CustomDropzone" model='new { Id = "excelDropzone", Name = "ExcelFile", Multiple = false, MaxSize = 10, AcceptedTypes = ".xlsx,.xls", Required = true, Label = "Archivo Excel" }' />

                    <div class="flex items-center gap-3">
                        <button type="submit"
                                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors">
                            <i class="ti ti-eye text-xs"></i> Vista Previa
                        </button>
                        <a href="/admin/importaciones/cepre/template"
                           class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
                            <i class="ti ti-download text-[11px]"></i> Descargar plantilla de ejemplo
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }

    @* ── Versiones existentes ── *@
    @if (Model.Versions.Count > 0)
    {
        <div class="fade-up mt-6 bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
            <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
                <span class="w-9 h-9 rounded-md bg-secondary-50 dark:bg-secondary-500/10 text-secondary-600 inline-flex items-center justify-center">
                    <i class="ti ti-git-branch text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Versiones de Importación</h2>
                    <p class="text-[11.5px] text-ink-500">@Model.Versions.Count versión(es) registrada(s)</p>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="atlas w-full text-xs">
                    <thead>
                        <tr>
                            <th class="text-center">Versión</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th class="text-center">Registros</th>
                            <th>Archivo</th>
                            <th>Estado</th>
                            @if (Model.IsSuperAdmin)
                            {
                                <th class="text-center">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var version in Model.Versions)
                        {
                            <tr>
                                <td class="text-center font-mono font-semibold">v@(version.VersionNumber)</td>
                                <td class="font-mono">@version.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@version.CreatedBy</td>
                                <td class="text-center font-mono font-semibold">@version.RecordCount</td>
                                <td>@(version.FileName ?? "—")</td>
                                <td>
                                    @if (version.IsLatest)
                                    {
                                        <span class="badge b-green">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge b-gray">Inactiva</span>
                                    }
                                </td>
                                @if (Model.IsSuperAdmin)
                                {
                                    <td class="text-center">
                                        <form asp-controller="CepreImport" asp-action="Revert" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="batchId" value="@version.Id" />
                                            <input type="hidden" name="SelectedTermId" value="@Model.SelectedTermId" />
                                            <button type="submit"
                                                    onclick="return confirm('¿Está seguro de eliminar esta versión? Se eliminarán todos los registros asociados.')"
                                                    class="inline-flex items-center gap-1 px-3 py-1 rounded-md bg-rose-50 text-rose-600 text-[11px] font-semibold hover:bg-rose-100 transition-colors">
                                                <i class="ti ti-trash text-[10px]"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (Model.HasPreview)
{
    var preview = Model.Preview!;
    <div class="fade-up mt-6 bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center justify-between rounded-t-md">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                    <i class="ti ti-table text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Vista Previa</h2>
                    <p class="text-[11.5px] text-ink-500">
                        Total: @preview.TotalRows filas ·
                        <span class="text-emerald-600 font-semibold">@preview.ValidRows válidas</span> ·
                        <span class="text-rose-600 font-semibold">@preview.InvalidRows con error</span>
                    </p>
                </div>
            </div>
            @if (preview.ValidRows > 0)
            {
                <form id="importForm" asp-controller="CepreImport" asp-action="Import" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SelectedTermId" value="@Model.SelectedTermId" />
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition-colors">
                        <i class="ti ti-check text-xs"></i> Importar @preview.ValidRows registros
                    </button>
                </form>
            }
        </div>

        <div class="px-4 sm:px-5 py-3 border-b border-ink-200/60 dark:border-ink-800/60 flex flex-wrap items-center gap-3">
            <span class="text-[11px] font-semibold text-ink-500 uppercase tracking-wide">Filtrar:</span>
            <div class="inline-flex rounded-md overflow-hidden ring-soft text-xs font-semibold" id="previewFilter">
                <button type="button" data-filter="all" class="px-3 py-1.5 bg-primary-600 text-white">Todas</button>
                <button type="button" data-filter="ok" class="px-3 py-1.5 bg-white text-ink-700 hover:bg-ink-100">Válidas</button>
                <button type="button" data-filter="error" class="px-3 py-1.5 bg-white text-rose-600 hover:bg-rose-50">Con error</button>
            </div>
            <span id="previewFilterCount" class="text-[11px] text-ink-400"></span>
        </div>

        <div class="overflow-x-auto">
            <table id="previewTable" class="atlas w-full text-xs">
                <thead>
                    <tr>
                        <th class="text-center">Nº</th>
                        <th>DNI</th>
                        <th>Apellidos y Nombres</th>
                        <th>Cód. Carrera</th>
                        <th>Carrera</th>
                        <th>Grupo</th>
                        <th class="text-center">Nota Final</th>
                        <th>Estado</th>
                        <th>Estado Fila</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in preview.Rows.OrderByDescending(r => r.IsValid).ThenBy(r => r.Nro))
                    {
                        <tr data-state="@(row.IsValid ? "ok" : "error")" class="@(row.IsValid ? "" : "bg-rose-50/50")">
                            <td class="text-center font-mono">@row.Nro</td>
                            <td class="font-mono font-semibold">@row.Dni</td>
                            <td>@row.ApellidosNombres</td>
                            <td class="font-mono">@row.CodigoCarrera</td>
                            <td>@row.CarreraProfesional</td>
                            <td class="text-center">@row.Grupo</td>
                            <td class="text-center font-mono font-semibold">@(row.NotaFinal?.ToString("F2") ?? "—")</td>
                            <td>
                                @if (string.Equals(row.Estado?.Trim(), "INGRESADO", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(row.Estado?.Trim(), "ADMITIDO", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge b-green">Ingresado</span>
                                }
                                else
                                {
                                    <span class="badge b-gray">@row.Estado</span>
                                }
                            </td>
                            <td>
                                @if (row.IsValid)
                                {
                                    <span class="badge b-green">Válida</span>
                                }
                                else
                                {
                                    <span class="badge b-rose">Con error :@row.ValidationError</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (preview.Rows.Count > 200)
        {
            <div class="px-4 py-3 text-center text-xs text-ink-400 border-t border-ink-100">
                Mostrando 200 de @preview.Rows.Count filas
            </div>
        }
    </div>
}

@section Scripts {
<script>
    (function () {
        var filterBar = document.getElementById('previewFilter');
        var table = document.getElementById('previewTable');
        if (!filterBar || !table) return;
        var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
        var countEl = document.getElementById('previewFilterCount');
        var buttons = Array.prototype.slice.call(filterBar.querySelectorAll('button[data-filter]'));

        function applyFilter(state) {
            var shown = 0;
            rows.forEach(function (row) {
                var show = state === 'all' || row.getAttribute('data-state') === state;
                row.style.display = show ? '' : 'none';
                if (show) shown++;
            });
            if (countEl) countEl.textContent = 'Mostrando ' + shown + ' de ' + rows.length + ' filas';
        }

        buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                buttons.forEach(function (b) {
                    if (b === btn) {
                        b.className = 'px-3 py-1.5 bg-primary-600 text-white';
                    } else if (b.getAttribute('data-filter') === 'error') {
                        b.className = 'px-3 py-1.5 bg-white text-rose-600 hover:bg-rose-50';
                    } else {
                        b.className = 'px-3 py-1.5 bg-white text-ink-700 hover:bg-ink-100';
                    }
                });
                applyFilter(btn.getAttribute('data-filter'));
            });
        });

        applyFilter('all');
    })();

    (function () {
        var successEl = document.getElementById('swalSuccess');
        var errorEl = document.getElementById('swalError');
        if (successEl) {
            Swal.fire({ icon: 'success', title: 'Importación procesada', text: successEl.value });
        } else if (errorEl) {
            Swal.fire({ icon: 'error', title: 'No se pudo procesar', text: errorEl.value });
        }
    })();

    (function () {
        var importForm = document.getElementById('importForm');
        if (!importForm) return;
        var validCount = @(Model.HasPreview ? Model.Preview!.ValidRows : 0);
        var invalidCount = @(Model.HasPreview ? Model.Preview!.InvalidRows : 0);

        importForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var msg;
            if (invalidCount > 0) {
                msg = 'Se importarán <b>' + validCount + '</b> registro(s) válido(s). Los <b>' + invalidCount + '</b> registro(s) no válido(s) <b>no se guardarán</b>.';
            } else {
                msg = 'Se importarán <b>' + validCount + '</b> registro(s) válido(s).';
            }
            msg += '<br/><br/>¿Desea continuar con la importación?';

            Swal.fire({
                title: 'Confirmar importación',
                html: msg,
                icon: invalidCount > 0 ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, importar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#059669'
            }).then(function (result) {
                if (result.isConfirmed) importForm.submit();
            });
        });
    })();
</script>
}
