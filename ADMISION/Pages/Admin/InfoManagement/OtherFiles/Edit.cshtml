@model ADMISION.ENTITIES.Models.Info.OtherFiles

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Formato/Archivo";
}

<!-- Breadcrumb + Page Hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/info-management" class="hover:text-primary-600 transition-colors">Información</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/info-management/other-files" class="hover:text-primary-600 transition-colors">Archivos</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Editar</span>
    </div>
    <div class="eyebrow">Documentos públicos</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Editar <span class="font-serif font-normal text-primary-600">@Model.Name</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Modifica los datos o reemplaza el archivo asociado.</p>
</section>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-5 max-w-2xl">

    <!-- Card: Datos del archivo -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-edit text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos del documento</h2>
                <p class="text-[11.5px] text-ink-500">Identificación y descripción del archivo</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <input type="hidden" asp-for="Id" />

            <partial name="_FormInput" model='@(new {
                Id = "Name", Name = "Name",
                Label = "Nombre del formato / documento", Required = true,
                Value = Model.Name,
                IconLeft = "ti-file-pencil",
                Error = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />

            <partial name="_FormTextarea" model='@(new {
                Id = "Description", Name = "Description",
                Label = "Descripción corta",
                Rows = 3,
                Value = Model.Description,
                Error = ViewData.ModelState["Description"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />

            <partial name="_FormCheckbox" model='@(new {
                Id = "IsActive", Name = "IsActive",
                Label = "Publicado",
                Hint = "Visible al público en la web institucional",
                Checked = Model.IsActive,
                Variant = "switch"
            })' />
        </div>
    </section>

    <!-- Card: Archivo -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-cloud-upload text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Archivo asociado</h2>
                <p class="text-[11.5px] text-ink-500">PDF, Word, Excel o imágenes hasta 15MB</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-4">

            @if (!string.IsNullOrEmpty(Model.FileUrl))
            {
                <div class="flex items-center justify-between gap-3 rounded-md bg-primary-50/60 dark:bg-primary-500/10 ring-1 ring-primary-200/60 dark:ring-primary-500/20 px-4 py-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="w-10 h-10 rounded-md bg-white dark:bg-ink-900 ring-1 ring-primary-200/60 inline-flex items-center justify-center shrink-0">
                            <i class="ti ti-paperclip text-primary-600"></i>
                        </span>
                        <div class="min-w-0">
                            <div class="text-[11px] font-bold uppercase tracking-[0.14em] text-primary-700">Archivo actual</div>
                            <div class="text-sm font-semibold text-ink-900 dark:text-ink-100 truncate">@Model.FileName</div>
                            <div class="text-[11px] text-ink-500">@Model.FileSize</div>
                        </div>
                    </div>
                    <a href="/@Model.FileUrl" target="_blank"
                       class="inline-flex items-center justify-center w-9 h-9 rounded-md ring-1 ring-primary-200 dark:ring-primary-500/30 text-primary-600 hover:bg-primary-50 dark:hover:bg-primary-500/10 transition-colors"
                       title="Descargar">
                        <i class="ti ti-download text-xs"></i>
                    </a>
                </div>
            }

            <label for="uploadFile"
                   class="block cursor-pointer rounded-md ring-1 ring-dashed ring-ink-300 dark:ring-ink-700 bg-ink-50/60 dark:bg-ink-900/40 hover:ring-primary-400 hover:bg-primary-50/40 dark:hover:bg-primary-500/5 transition-all px-6 py-10 text-center">
                <i id="file-icon" class="ti ti-cloud-upload text-4xl text-ink-300 mb-3 block"></i>
                <div id="file-info" class="hidden mb-3">
                    <span id="file-name" class="block text-sm font-semibold text-ink-900 dark:text-ink-100"></span>
                    <span id="file-size" class="block text-xs text-ink-400 mt-0.5"></span>
                </div>
                <p class="text-sm font-semibold text-primary-600">
                    @(string.IsNullOrEmpty(Model.FileUrl) ? "Seleccionar archivo" : "Reemplazar archivo")
                </p>
                <p class="text-[11px] text-ink-400 mt-1">o arrastra y suelta aquí · máx. 15MB</p>
                <input id="uploadFile" name="uploadFile" type="file" class="sr-only" onchange="handleFileSelect(this)">
            </label>
        </div>
    </section>

    <!-- Acciones -->
    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar cambios
        </button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/admin/info-management/other-files/form.js" asp-append-version="true"></script>
}
