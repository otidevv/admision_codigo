@model IEnumerable<ADMISION.ENTITIES.Models.Info.Brochure>

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Brochures";
}

@{
    var columns = new List<ADMISION.Models.Shared.DataTableColumn>
    {
        new() { Label = "Nombre",         Field = "name",        Type = "combined", SubField = "description", Sortable = true },
        new() { Label = "Nombre Original", Field = "fileName",    Type = "text",     Sortable = true },
        new() { Label = "Detalles",        Field = "fileDetails", Type = "text" },
        new() { Label = "Estado",          Field = "statusText",  Type = "badge",    BadgeMap = new Dictionary<string, string> { { "Activo", "green" }, { "Inactivo", "gray" } } },
    };

    ViewData["Columns"] = columns;
    ViewData["TableId"] = "brochuresTable";
    ViewData["ClientSide"] = true;
    ViewData["Actions"] = new List<ADMISION.Models.Shared.DataTableAction>
    {
        new() { Key="download", Label="Descargar", Icon="ti-download",  Href="/{fileUrl}", Target="_blank" },
        new() { Key="edit",     Label="Editar",    Icon="ti-edit",      Href="/admin/info-management/brochures/editar/{id}" },
        new() { Key="delete",   Label="Eliminar",  Icon="ti-trash", Danger=true }
    };
}

<!-- Page hero -->
<section class="fade-up flex flex-wrap items-end justify-between gap-4 mb-5">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
            <a href="/admin/info-management" class="hover:text-primary-600 transition-colors">Información</a>
            <i class="ti ti-chevron-right text-[9px]"></i>
            <span class="text-ink-700 dark:text-ink-200 font-medium">Brochures</span>
        </div>
        <div class="eyebrow">Documentos públicos</div>
        <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
            Brochures <span class="font-serif font-normal text-primary-600">informativos</span>
        </h1>
        <p class="text-ink-500 text-sm mt-1">Guías y folletos de inscripción que se descargan al finalizar el registro.</p>
    </div>
    <a href="/admin/info-management/brochures/crear" class="btn-grad inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-md hover:-translate-y-0.5 transition-all">
        <i class="ti ti-plus text-xs"></i>
        Nuevo brochure
    </a>
</section>

<!-- Filter Bar -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-6">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-filter text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Filtros de búsqueda</h2>
            <p class="text-[11.5px] text-ink-500">Encuentra rápidamente el brochure que necesitas</p>
        </div>
    </div>

    <div class="p-4 sm:p-5">
        <div class="max-w-md">
            <partial name="_FormInput" model='@(new {
                Id = "filterName",
                Name = "filterName",
                Label = "Búsqueda rápida",
                Placeholder = "Escriba el nombre del brochure...",
                IconLeft = "ti-search"
            })' />
        </div>
    </div>
</section>

<!-- Tabla -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
    <div id="tableContainer">
        @await Html.PartialAsync("_DataTable", new ViewDataDictionary(ViewData))
    </div>
</section>

@* Token antiforgery para operaciones POST desde JS *@
<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        window.BrochureData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(o => new {
            o.Id,
            o.Name,
            o.Description,
            o.FileName,
            o.FileUrl,
            FileDetails = $"{o.FileType} ({o.FileSize})",
            StatusText = o.IsActive ? "Activo" : "Inactivo"
        }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    </script>
    <script src="~/js/admin/info-management/brochure/index.js" asp-append-version="true"></script>
}
