@model ADMISION.ENTITIES.Models.Modality.Beneficiarie

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Crear Beneficiario";
    var termOptions = ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.TermId)
        .Select(i => new { id = i.Value, name = i.Text });
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/info-management" class="hover:text-primary-600 transition-colors">Publicaciones</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/info-management/beneficiaries" class="hover:text-primary-600 transition-colors">Beneficiarios</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Nuevo beneficiario</span>
    </div>
    <div class="eyebrow">Portal público</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Crear nuevo <span class="font-serif font-normal text-primary-600">beneficiario</span>
    </h1>
</section>

<form asp-action="Create" method="post" class="space-y-5 max-w-2xl">
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-heart-handshake text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos del beneficiario</h2>
                <p class="text-[11.5px] text-ink-500">Define el tipo y porcentaje de descuento</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <div>
                <partial name="_CustomSelect" model='new { Id = "TermId", Name = "TermId", Label = "Periodo", Required = true, Options = termOptions }' />
                <span asp-validation-for="TermId" class="text-xs text-rose-500 mt-1"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <partial name="_FormInput" model='@(new {
                    Id = "Name", Name = "Name",
                    Label = "Nombre", Required = true,
                    Placeholder = "Ej: Beca por Deporte",
                    Value = Model?.Name,
                    IconLeft = "ti-tag",
                    Error = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />

                <partial name="_FormInput" model='@(new {
                    Id = "PercentageDiscount", Name = "PercentageDiscount",
                    Label = "Descuento (%)", Required = true, Type = "number",
                    Value = Model?.PercentageDiscount.ToString(),
                    Min = "0", Max = "100",
                    IconLeft = "ti-percentage",
                    Error = ViewData.ModelState["PercentageDiscount"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />
            </div>

            <partial name="_FormTextarea" model='@(new {
                Id = "Description", Name = "Description",
                Label = "Descripción",
                Placeholder = "Detalle del beneficio...",
                Value = Model?.Description,
                Rows = 3,
                Error = ViewData.ModelState["Description"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />

            <partial name="_FormCheckbox" model='@(new {
                Id = "IsActive", Name = "IsActive",
                Label = "Beneficiario activo",
                Hint = "Disponible para aplicarse en las inscripciones.",
                Variant = "switch",
                Checked = Model?.IsActive ?? true
            })' />
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar
        </button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
