@using ADMISION.Models.Shared
@model IEnumerable<ADMISION.ENTITIES.Models.Info.OtherFiles>

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reglamentos";

    var columns = new List<DataTableColumn>
    {
        new() { Label = "Reglamento",      Field = "name",       Type = "combined", SubField = "description", Sortable = true },
        new() { Label = "Nombre Original", Field = "fileName",   Type = "text",     Sortable = true },
        new() { Label = "Detalles",        Field = "fileDetails", Type = "text" },
        new() { Label = "Estado",          Field = "statusText", Type = "badge",
                BadgeMap = new Dictionary<string, string> { { "Activo", "green" }, { "Inactivo", "gray" } } },
    };

    ViewData["Columns"] = columns;
    ViewData["TableId"] = "regulationsTable";
    ViewData["ClientSide"] = true;
    ViewData["Actions"] = new List<DataTableAction>
    {
        new() { Key="download", Label="Descargar", Icon="ti-download",  Href="/{fileUrl}", Target="_blank" },
        new() { Key="edit",     Label="Editar",    Icon="ti-edit",      Href="/admin/info-management/regulations/editar/{id}" },
        new() { Key="delete",   Label="Eliminar",  Icon="ti-trash", Danger=true }
    };
}

<!-- Page hero -->
<section class="fade-up flex flex-wrap items-end justify-between gap-4 mb-5">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
            <a href="/admin/info-management" class="hover:text-primary-600 transition-colors">Información</a>
            <i class="ti ti-chevron-right text-[9px]"></i>
            <span class="text-ink-700 dark:text-ink-200 font-medium">Reglamentos</span>
        </div>
        <div class="eyebrow">Normativa institucional</div>
        <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
            <span class="font-serif font-normal text-primary-600">Reglamentos</span> de admisión
        </h1>
        <p class="text-ink-500 text-sm mt-1">Reglamento General de Admisión y normativas relacionadas.</p>
    </div>
    <a href="/admin/info-management/regulations/crear" class="btn-grad inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-md hover:-translate-y-0.5 transition-all">
        <i class="ti ti-plus text-xs"></i>
        Nuevo reglamento
    </a>
</section>

<!-- Filtro -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-5">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-filter text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Filtrar reglamentos</h2>
            <p class="text-[11.5px] text-ink-500">Busca por nombre, descripción o archivo</p>
        </div>
    </div>
    <div class="p-4 sm:p-5">
        <div class="max-w-md">
            <label class="block text-[10px] font-bold text-ink-400 uppercase tracking-widest mb-1.5 ml-1">Buscar por nombre</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-ink-400">
                    <i class="ti ti-search text-xs"></i>
                </div>
                <input type="text" id="filterName" class="w-full h-11 bg-white dark:bg-ink-800 ring-soft rounded-md pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="Escriba el nombre del reglamento…">
            </div>
        </div>
    </div>
</section>

<!-- Tabla -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
    <div id="tableContainer">
        @await Html.PartialAsync("_DataTable", new ViewDataDictionary(ViewData))
    </div>
</section>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        window.RegulationsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(o => new {
            o.Id,
            o.Name,
            o.Description,
            o.FileName,
            o.FileUrl,
            FileDetails = $"{o.FileType} ({o.FileSize})",
            StatusText = o.IsActive ? "Activo" : "Inactivo"
        }), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    </script>
    <script src="~/js/admin/info-management/regulations/index.js" asp-append-version="true"></script>
}
