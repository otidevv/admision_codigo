@model ADMISION.ENTITIES.Models.Info.PublicInfo

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Descripción de Modalidad";
    var terms = (IEnumerable<dynamic>)ViewBag.Terms;
    var modalities = (IEnumerable<dynamic>)ViewBag.Modalities;
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/info-management" class="hover:text-primary-600 transition-colors">Información</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/info-management/public-infos" class="hover:text-primary-600 transition-colors">Descripciones</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Editar</span>
    </div>
    <div class="eyebrow">Contenido público</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Editar <span class="font-serif font-normal text-primary-600">descripción</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Modifica los campos necesarios y guarda los cambios.</p>
</section>

<form asp-action="Edit" method="post" class="space-y-5 max-w-4xl">
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-edit text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos de la descripción</h2>
                <p class="text-[11.5px] text-ink-500">Actualiza periodo, modalidad y contenido</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="All"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-4">
                <div>
                    <partial name="_CustomSelect" model='new {
                        Id = "TermId",
                        Name = "TermId",
                        Label = "Periodo académico",
                        Required = true,
                        Placeholder = "Seleccionar periodo",
                        SelectedValue = Model.TermId != Guid.Empty ? Model.TermId.ToString() : "",
                        Options = terms
                    }' />
                </div>

                <div>
                    <partial name="_CustomSelect" model='new {
                        Id = "ModalityId",
                        Name = "ModalityId",
                        Label = "Modalidad (opcional)",
                        Required = false,
                        Placeholder = "Sin modalidad específica",
                        SelectedValue = Model.ModalityId.HasValue ? Model.ModalityId.Value.ToString() : "",
                        Options = modalities
                    }' />
                    <p class="text-[11px] text-ink-400 mt-1">Si la dejas vacía, será contenido general del periodo.</p>
                </div>

                <div class="md:col-span-2">
                    <partial name="_FormInput" model='@(new {
                        Id = "Title", Name = "Title",
                        Label = "Título", Required = true,
                        Value = Model.Title,
                        IconLeft = "ti-heading",
                        Error = ViewData.ModelState["Title"]?.Errors.FirstOrDefault()?.ErrorMessage
                    })' />
                </div>

                <div class="md:col-span-2">
                    <partial name="_FormTextarea" model='@(new {
                        Id = "Description", Name = "Description",
                        Label = "Contenido / descripción",
                        Rows = 10,
                        Value = Model.Description,
                        Error = ViewData.ModelState["Description"]?.Errors.FirstOrDefault()?.ErrorMessage
                    })' />
                </div>

                <partial name="_FormInput" model='@(new {
                    Id = "Url", Name = "Url",
                    Label = "Enlace de referencia (opcional)",
                    Value = Model.Url,
                    IconLeft = "ti-link",
                    Error = ViewData.ModelState["Url"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />

                <partial name="_FormInput" model='@(new {
                    Id = "DisplayOrder", Name = "DisplayOrder",
                    Label = "Orden de visualización",
                    Type = "number", Min = "0",
                    Value = Model.DisplayOrder.ToString(),
                    IconLeft = "ti-sort-ascending-numbers",
                    Helper = "Menor número = aparece primero dentro de la modalidad.",
                    Error = ViewData.ModelState["DisplayOrder"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />

                <div class="md:col-span-2">
                    <partial name="_FormCheckbox" model='@(new {
                        Id = "IsActive", Name = "IsActive",
                        Label = "Publicado",
                        Hint = "Visible en el portal público",
                        Checked = Model.IsActive,
                        Variant = "default"
                    })' />
                </div>
            </div>
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar cambios
        </button>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin/info-management/public-info/form.js" asp-append-version="true"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
