@using ADMISION.ENTITIES.Constants
@model Dictionary<string, string>

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Información del Sistema";

    bool IsSocial(string k) =>
        k.Contains("Url") || k.Contains("Facebook") || k.Contains("Instagram")
        || k.Contains("Youtube") || k.Contains("Tiktok") || k.Contains("Twitter");

    bool IsSmtp(string k) => k.StartsWith("Smtp", StringComparison.Ordinal);

    string SmtpLabel(string k) => k switch
    {
        "SmtpHost" => "Servidor SMTP",
        "SmtpPort" => "Puerto",
        "SmtpEnableSsl" => "Conexión segura (SSL/TLS)",
        "SmtpSenderName" => "Nombre del remitente",
        "SmtpEmail" => "Correo remitente (cuenta)",
        "SmtpPassword" => "Clave de aplicación",
        _ => k
    };
}

<!-- Page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
        <a href="/admin/config" class="hover:text-primary-600 transition-colors">Configuración</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Información del sistema</span>
    </div>
    <div class="eyebrow">Datos institucionales</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Parámetros del <span class="font-serif font-normal text-primary-600">sistema</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1 max-w-2xl">
        Administra los datos básicos de la institución, redes sociales y contacto.
    </p>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="fade-up mb-6 p-4 bg-emerald-50 dark:bg-emerald-500/10 ring-1 ring-emerald-200 dark:ring-emerald-500/30 text-emerald-700 dark:text-emerald-300 rounded-md flex items-center gap-3">
        <i class="ti ti-circle-check"></i>
        <span class="text-sm">@TempData["SuccessMessage"]</span>
    </div>
}

<form asp-action="Update" method="post" class="space-y-5">
    @Html.AntiForgeryToken()

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-info-circle text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Configuración general</h2>
                <p class="text-[11.5px] text-ink-500">Identidad, contacto y presencia digital</p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                @foreach (var config in Model.Where(c => !IsSmtp(c.Key)))
                {
                    <div class="form-field">
                        <label class="form-label">@config.Key</label>
                        @if (config.Key.Contains("Color"))
                        {
                            <div class="flex gap-2">
                                <input type="color" name="configs[@config.Key]" value="@config.Value"
                                       class="h-12 w-20 p-1 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 cursor-pointer bg-white dark:bg-ink-800" />
                                <input type="text" value="@config.Value" readonly
                                       class="form-input flex-1 font-mono bg-ink-50 dark:bg-ink-800/60 text-ink-500" />
                            </div>
                        }
                        else if (IsSocial(config.Key))
                        {
                            <div class="form-input-wrapper">
                                <i class="ti ti-link form-input-icon"></i>
                                <input type="text" name="configs[@config.Key]" value="@config.Value"
                                       class="form-input" />
                            </div>
                        }
                        else
                        {
                            <input type="text" name="configs[@config.Key]" value="@config.Value"
                                   class="form-input" />
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-secondary-100 dark:bg-secondary-500/10 text-secondary-700 inline-flex items-center justify-center">
                <i class="ti ti-mail text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Servidor de correo (SMTP)</h2>
                <p class="text-[11.5px] text-ink-500">Credenciales para enviar correos automáticos (Gmail / SMTP)</p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                @foreach (var config in Model.Where(c => IsSmtp(c.Key)))
                {
                    <div class="form-field">
                        <label class="form-label">@SmtpLabel(config.Key)</label>
                        @if (config.Key == ConfigGeneral.SmtpPassword)
                        {
                            <div class="form-input-wrapper">
                                <i class="ti ti-key form-input-icon"></i>
                                <input type="password" name="configs[@config.Key]" value="@config.Value"
                                       class="form-input" autocomplete="new-password"
                                       placeholder="••••••••••••••••" />
                            </div>
                            <p class="form-helper text-ink-400">Dejar en blanco para mantener la clave actual.</p>
                        }
                        else if (config.Key == ConfigGeneral.SmtpPort)
                        {
                            <div class="form-input-wrapper">
                                <i class="ti ti-server form-input-icon"></i>
                                <input type="number" name="configs[@config.Key]" value="@config.Value"
                                       class="form-input" min="1" max="65535" />
                            </div>
                        }
                        else if (config.Key == ConfigGeneral.SmtpEnableSsl)
                        {
                            <select name="configs[@config.Key]" class="form-input">
                                <option value="true" selected="@(config.Value == "true")">Sí (recomendado)</option>
                                <option value="false" selected="@(config.Value != "true")">No</option>
                            </select>
                        }
                        else
                        {
                            <div class="form-input-wrapper">
                                <i class="ti ti-mail form-input-icon"></i>
                                <input type="text" name="configs[@config.Key]" value="@config.Value"
                                       class="form-input" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a href="/admin/config"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar cambios
        </button>
    </div>
</form>
