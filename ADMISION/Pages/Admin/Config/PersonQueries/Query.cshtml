@model ADMISION.ENTITIES.Models.Integrations.ExternalApi

@{
    ViewData["Title"] = $"Consultar — {Model.Name}";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";

    string CategoryIcon(string c) => c switch
    {
        "Academic" => "ti-school",
        "Payment"  => "ti-coin",
        _          => "ti-plug"
    };
}

<!-- Page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
        <a href="/admin/config" class="hover:text-primary-600 transition-colors">Configuración</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/consultas" class="hover:text-primary-600 transition-colors">Consultas por DNI</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">@Model.Name</span>
    </div>
    <div class="eyebrow">Consulta</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        @Model.Name
    </h1>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-ink-500 text-sm mt-1 max-w-2xl">@Model.Description</p>
    }
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-300 font-semibold">
            <i class="ti @CategoryIcon(Model.Category) text-[10px]"></i> @Model.Category
        </span>
        <code class="text-xs text-ink-600 dark:text-ink-300 break-all font-mono">@Model.Url</code>
    </div>
</section>

<div class="max-w-6xl">
    <!-- Card: DNI input -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-user-search text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Ingresa el DNI</h2>
                <p class="text-[11.5px] text-ink-500">El DNI se adjuntará al final de la ruta de la API para realizar la consulta</p>
            </div>
        </div>
        <form id="queryForm" class="p-4 sm:p-5" data-api-id="@Model.Id" data-category="@Model.Category">
            @Html.AntiForgeryToken()
            <div class="flex flex-col sm:flex-row items-start sm:items-end gap-4">
                <div class="form-field flex-1 w-full sm:w-auto">
                    <label for="dni" class="form-label">DNI <span class="required">*</span></label>
                    <div class="form-input-wrapper">
                        <i class="ti ti-id form-input-icon"></i>
                        <input type="text" id="dni" name="dni" required maxlength="8"
                               class="form-input font-mono tracking-widest text-lg"
                               placeholder="12345678"
                               autocomplete="off" />
                    </div>
                </div>
                <button type="submit" id="executeBtn"
                        class="btn-grad inline-flex items-center gap-2 px-6 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all whitespace-nowrap">
                    <i class="ti ti-player-play text-xs"></i> Consultar
                </button>
            </div>
        </form>
    </section>

    <!-- Card: Resultado Académico -->
    <section id="academicResult" class="fade-up hidden bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center justify-between gap-3 rounded-t-md">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 inline-flex items-center justify-center">
                    <i class="ti ti-school text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Información académica</h2>
                    <p class="text-[11.5px] text-ink-500">Datos académicos del postulante</p>
                </div>
            </div>
            <div id="academicMeta" class="text-xs text-ink-500 font-mono"></div>
        </div>
        <div id="academicError" class="hidden p-4 sm:p-5 text-sm text-rose-700 bg-rose-50 dark:bg-rose-500/10 dark:text-rose-300 border-b border-rose-100 dark:border-rose-500/30"></div>
        <div id="academicContent" class="p-4 sm:p-5 space-y-4"></div>
        <div class="border-t border-ink-200/60 dark:border-ink-800/60 px-4 sm:px-5 py-3 flex justify-between items-center">
            <button type="button" id="saveAcademicBtn"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all hidden"
                    data-logid="">
                <i class="ti ti-device-floppy text-xs"></i> Guardar en BD
            </button>
            <details class="text-xs text-ink-500">
                <summary class="cursor-pointer font-semibold hover:text-ink-700 dark:hover:text-ink-200">
                    <i class="ti ti-code mr-1 text-[10px]"></i> Ver respuesta cruda
                </summary>
                <pre id="academicRaw" class="mt-2 p-3 bg-ink-50 dark:bg-ink-800/60 rounded-md overflow-auto max-h-48 text-[11px] font-mono"></pre>
            </details>
        </div>
    </section>

    <!-- Card: Resultado Pagos -->
    <section id="paymentResult" class="fade-up hidden bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center justify-between gap-3 rounded-t-md">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-md bg-amber-50 dark:bg-amber-500/10 text-amber-600 inline-flex items-center justify-center">
                    <i class="ti ti-coin text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Historial de pagos</h2>
                    <p class="text-[11.5px] text-ink-500">Comprobantes y pagos realizados</p>
                </div>
            </div>
            <div id="paymentMeta" class="text-xs text-ink-500 font-mono"></div>
        </div>
        <div id="paymentError" class="hidden p-4 sm:p-5 text-sm text-rose-700 bg-rose-50 dark:bg-rose-500/10 dark:text-rose-300 border-b border-rose-100 dark:border-rose-500/30"></div>
        <div id="paymentContent" class="p-4 sm:p-5 space-y-4"></div>
        <div class="border-t border-ink-200/60 dark:border-ink-800/60 px-4 sm:px-5 py-3 flex justify-between items-center">
            <button type="button" id="savePaymentBtn"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all hidden"
                    data-logid="">
                <i class="ti ti-device-floppy text-xs"></i> Guardar en BD
            </button>
            <details class="text-xs text-ink-500">
                <summary class="cursor-pointer font-semibold hover:text-ink-700 dark:hover:text-ink-200">
                    <i class="ti ti-code mr-1 text-[10px]"></i> Ver respuesta cruda
                </summary>
                <pre id="paymentRaw" class="mt-2 p-3 bg-ink-50 dark:bg-ink-800/60 rounded-md overflow-auto max-h-48 text-[11px] font-mono"></pre>
            </details>
        </div>
    </section>

    <!-- Card: Error General -->
    <section id="errorResult" class="fade-up hidden bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-rose-50 dark:bg-rose-500/10 text-rose-600 inline-flex items-center justify-center">
                <i class="ti ti-alert-circle text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Error en la consulta</h2>
                <p class="text-[11.5px] text-ink-500">No se pudo completar la consulta</p>
            </div>
        </div>
        <div id="errorContent" class="p-4 sm:p-5 text-sm text-rose-700"></div>
    </section>
</div>

@section Scripts {
    <script>
        window.PersonQueryConfig = {
            apiId: '@Model.Id',
            category: '@Model.Category'
        };
    </script>
    <script src="~/js/admin/config/person-queries/query.js" asp-append-version="true"></script>
}
