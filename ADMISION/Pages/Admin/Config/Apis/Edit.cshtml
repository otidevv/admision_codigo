@model ADMISION.ENTITIES.Models.Integrations.ExternalApi

@{
    ViewData["Title"] = "Editar API";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/config" class="hover:text-primary-600 transition-colors">Configuración</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/config/apis" class="hover:text-primary-600 transition-colors">APIs externas</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Editar</span>
    </div>
    <div class="eyebrow">Integraciones</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Editar <span class="font-serif font-normal text-primary-600">@Model.Name</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Si dejas el campo «Token» vacío, conservaremos el secreto guardado.</p>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-5 max-w-6xl">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    @* No exponemos el AuthValue actual al cliente — el placeholder pide dejar vacío para conservarlo. *@

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-edit text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Configuración de la integración</h2>
                <p class="text-[11.5px] text-ink-500">Modifica los campos necesarios y guarda los cambios</p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <partial name="~/Pages/Admin/Config/Apis/_Form.cshtml" model="Model" />
        </div>
    </section>

    <div class="fade-up flex flex-col-reverse sm:flex-row sm:justify-between sm:items-center gap-3 pt-2">
        <a asp-action="Test" asp-route-id="@Model.Id"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-1 ring-emerald-200 dark:ring-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-sm font-semibold hover:bg-emerald-50 dark:hover:bg-emerald-500/10 transition-all">
            <i class="ti ti-player-play text-xs"></i> Probar consulta
        </a>
        <div class="flex flex-col-reverse sm:flex-row gap-3">
            <a asp-action="Index"
               class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
                <i class="ti ti-arrow-left text-xs"></i> Cancelar
            </a>
            <button type="submit"
                    class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
                <i class="ti ti-device-floppy text-xs"></i> Actualizar
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
