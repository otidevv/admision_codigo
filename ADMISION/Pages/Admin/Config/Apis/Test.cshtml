@using System.Text.RegularExpressions
@model ADMISION.ENTITIES.Models.Integrations.ExternalApi

@{
    ViewData["Title"] = $"Consultar — {Model.Name}";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";

    string MethodBadge(string m) => m switch
    {
        "GET"    => "b-blue",
        "POST"   => "b-green",
        "PUT"    => "b-amber",
        "DELETE" => "b-primary",
        _         => "b-gray"
    };

    // Extraer placeholders {algo} de la URL y armar params automáticos
    var urlParams = Regex.Matches(Model.Url ?? "", @"\{([A-Za-z0-9_]+)\}")
        .Select(m => new { key = m.Groups[1].Value, label = m.Groups[1].Value.ToUpper(), required = true })
        .ToList();
}

<!-- Page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
        <a href="/admin/config" class="hover:text-primary-600 transition-colors">Configuración</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/config/apis" class="hover:text-primary-600 transition-colors">APIs</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">@Model.Name</span>
    </div>
    <div class="eyebrow">Pruebas de integración</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Consultar <span class="font-serif font-normal text-primary-600">@Model.Name</span>
    </h1>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-ink-500 text-sm mt-1 max-w-2xl">@Model.Description</p>
    }
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="badge @MethodBadge(Model.HttpMethod) font-mono">@Model.HttpMethod</span>
        <code class="text-xs text-ink-600 dark:text-ink-300 break-all font-mono">@Model.Url</code>
    </div>
</section>

<div class="max-w-5xl">
    <!-- Card: Parámetros -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-5">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-send text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Parámetros de la consulta</h2>
                <p class="text-[11.5px] text-ink-500">Ingresa los valores para ejecutar la API</p>
            </div>
        </div>
        <form id="apiTestForm" asp-action="TestExecute" asp-route-id="@Model.Id" method="post" class="p-4 sm:p-5 space-y-5">
            @Html.AntiForgeryToken()
            <div id="paramFields" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @* Generado por JS desde los config *@
            </div>
            <div class="pt-2 flex justify-end">
                <button type="submit" id="executeBtn"
                        class="btn-grad inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
                    <i class="ti ti-player-play text-xs"></i> Ejecutar consulta
                </button>
            </div>
        </form>
    </section>

    <!-- Card: Resultado -->
    <section id="resultPanel" class="fade-up hidden bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center justify-between gap-3 rounded-t-md">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-md bg-secondary-50 dark:bg-secondary-500/10 text-secondary-600 inline-flex items-center justify-center">
                    <i class="ti ti-table text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Resultado</h2>
                    <p class="text-[11.5px] text-ink-500">Datos devueltos por la integración</p>
                </div>
            </div>
            <div id="resultMeta" class="text-xs text-ink-500 font-mono"></div>
        </div>
        <div id="resultError"
             class="hidden p-4 sm:p-5 text-sm text-rose-700 bg-rose-50 dark:bg-rose-500/10 dark:text-rose-300 border-b border-rose-100 dark:border-rose-500/30"></div>
        <div class="overflow-x-auto">
            <table id="resultTable" class="atlas w-full">
                <thead>
                    <tr>
                        <th class="w-1/3">Campo</th>
                        <th>Valor</th>
                    </tr>
                </thead>
                <tbody id="resultRows"></tbody>
            </table>
        </div>
        <details class="border-t border-ink-200/60 dark:border-ink-800/60">
            <summary class="cursor-pointer px-4 sm:px-5 py-3 text-xs font-semibold text-ink-500 hover:bg-ink-50 dark:hover:bg-ink-800/60">
                <i class="ti ti-code mr-1 text-[10px]"></i> Ver respuesta cruda (JSON)
            </summary>
            <pre id="rawResponse" class="px-4 sm:px-5 py-4 text-xs text-ink-700 dark:text-ink-200 bg-ink-50 dark:bg-ink-800/60 overflow-auto max-h-96 font-mono"></pre>
        </details>
    </section>
</div>

@section Scripts {
    <script>
        window.ApiTestConfig = {
            params: @Html.Raw(string.IsNullOrWhiteSpace(Model.RequestParametersJson) ? "null" : Model.RequestParametersJson),
            urlParams: @Html.Raw(Json.Serialize(urlParams))
        };
    </script>
    <script src="~/js/admin/config/apis/test.js" asp-append-version="true"></script>
}
