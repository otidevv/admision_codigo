@model List<ADMISION.ENTITIES.Models.Integrations.ApiQueryLog>

@{
    ViewData["Title"] = "Historial de Consultas";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    var apis = (List<ADMISION.ENTITIES.Models.Integrations.ExternalApi>)ViewBag.Apis;
    var selectedApiId = (Guid?)ViewBag.SelectedApiId;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<!-- Page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
        <a href="/admin/config" class="hover:text-primary-600 transition-colors">Configuración</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/config/apis" class="hover:text-primary-600 transition-colors">APIs</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Historial</span>
    </div>
    <div class="eyebrow">Auditoría</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Historial de <span class="font-serif font-normal text-primary-600">consultas</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1 max-w-2xl">
        Cada llamada a una API registrada queda aquí con quién la hizo, cuándo y cuál fue el resultado.
    </p>
</section>

<!-- Filtros -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-5">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-filter text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Filtrar registros</h2>
            <p class="text-[11.5px] text-ink-500">Refina por integración</p>
        </div>
    </div>
    <form method="get" class="p-4 sm:p-5 flex flex-wrap items-end gap-3">
        <div class="flex-1 min-w-[240px] form-field">
            <label class="form-label">Filtrar por API</label>
            <div class="form-input-wrapper">
                <i class="ti ti-plug form-input-icon"></i>
                <select name="apiId" class="form-input">
                    <option value="">— Todas —</option>
                    @foreach (var api in apis)
                    {
                        <option value="@api.Id" selected="@(selectedApiId == api.Id)">@api.Name</option>
                    }
                </select>
            </div>
        </div>
        <button type="submit"
                class="btn-grad inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-filter text-xs"></i> Filtrar
        </button>
    </form>
</section>

<!-- Tabla de logs -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
    <div class="overflow-x-auto">
        <table class="atlas w-full">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>API</th>
                    <th>Usuario</th>
                    <th>Parámetros</th>
                    <th class="text-center">Estado</th>
                    <th class="text-right">Duración</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-xs text-ink-600 dark:text-ink-300 whitespace-nowrap font-mono">
                                @log.QueriedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td class="font-semibold text-ink-900 dark:text-ink-100">@(log.Api?.Name ?? "—")</td>
                            <td>
                                <div class="text-ink-700 dark:text-ink-200">@log.UserName</div>
                                @if (!string.IsNullOrEmpty(log.IpAddress))
                                {
                                    <div class="text-xs text-ink-400 font-mono">@log.IpAddress</div>
                                }
                            </td>
                            <td class="max-w-md">
                                <code class="text-xs text-ink-500 dark:text-ink-400 break-all font-mono">@log.RequestParametersJson</code>
                            </td>
                            <td class="text-center">
                                @if (log.ResponseSuccess)
                                {
                                    <span class="badge b-green font-mono">
                                        <i class="ti ti-check text-[9px]"></i> @log.ResponseStatus
                                    </span>
                                }
                                else
                                {
                                    <span class="badge b-amber font-mono" title="@log.ErrorMessage">
                                        <i class="ti ti-x text-[9px]"></i> @(log.ResponseStatus == 0 ? "ERROR" : log.ResponseStatus.ToString())
                                    </span>
                                }
                            </td>
                            <td class="text-right text-xs text-ink-500 font-mono tabular-nums">@log.DurationMs ms</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model == null || !Model.Any())
    {
        <div class="py-14 text-center">
            <i class="ti ti-history text-4xl text-ink-300 mb-3 block"></i>
            <p class="text-ink-400 text-sm font-medium">Sin consultas registradas para el filtro actual.</p>
        </div>
    }
</section>

@if (totalPages > 1)
{
    <div class="fade-up mt-5 flex flex-wrap items-center justify-between gap-3 text-sm">
        <span class="text-ink-500">Página <strong class="text-ink-700 dark:text-ink-200">@currentPage</strong> de <strong class="text-ink-700 dark:text-ink-200">@totalPages</strong> — @ViewBag.TotalItems registros</span>
        <div class="flex gap-2">
            @if (currentPage > 1)
            {
                <a asp-action="Logs" asp-route-apiId="@selectedApiId" asp-route-page="@(currentPage - 1)"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
                    <i class="ti ti-chevron-left text-[10px]"></i> Anterior
                </a>
            }
            @if (currentPage < totalPages)
            {
                <a asp-action="Logs" asp-route-apiId="@selectedApiId" asp-route-page="@(currentPage + 1)"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
                    Siguiente <i class="ti ti-chevron-right text-[10px]"></i>
                </a>
            }
        </div>
    </div>
}
