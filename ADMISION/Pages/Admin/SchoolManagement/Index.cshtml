@using ADMISION.Models.Shared
@model List<ADMISION.ENTITIES.Models.Schools.Schools>

@{
    ViewData["Title"] = "Gestión de Colegios";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";

    var columns = new List<DataTableColumn>
    {
        new() { Label = "Institución Educativa", Field = "name",         Type = "combined", SubField = "address",                   Sortable = true },
        new() { Label = "Código",                Field = "code",         Type = "code",     Align = "center",                       Sortable = true },
        new() { Label = "UGEL",                  Field = "ugelName",     Type = "text"                                                              },
        new() { Label = "Nivel / Modalidad",     Field = "level",        Type = "combined", SubField = "modality",                  Sortable = true },
        new() { Label = "Gestión",               Field = "management",   Type = "text",     Align = "center"                                                       },
        new() { Label = "Ubicación",             Field = "distrit.name", Type = "combined", SubField = "distrit.province.name",     Sortable = true },
    };

    ViewData["Columns"]     = columns;
    ViewData["AjaxUrl"]     = "/admin/colegios/";
    ViewData["TableId"]     = "schoolsTable";
    ViewData["ShowActions"] = false;
    ViewData["Theme"]       = "blue";
}

<!-- Page hero -->
<section class="fade-up flex flex-wrap items-end justify-between gap-4 mb-5">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
            <a href="/admin" class="hover:text-primary-600 transition-colors">Admin</a>
            <i class="ti ti-chevron-right text-[9px]"></i>
            <span class="text-ink-700 dark:text-ink-200 font-medium">Colegios</span>
        </div>
        <div class="eyebrow">Catálogo institucional</div>
        <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
            Instituciones <span class="font-serif font-normal text-primary-600">educativas</span>
        </h1>
        <p class="text-ink-500 text-sm mt-1">Busca, filtra e importa colegios para el proceso de admisión.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-action="Import" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-file-spreadsheet text-xs"></i> Importar Excel
        </a>
        <a asp-action="Create" class="btn-grad inline-flex items-center gap-2 text-sm font-semibold px-4 py-2.5 rounded-md hover:-translate-y-0.5 transition-all">
            <i class="ti ti-plus text-xs"></i>
            Nuevo colegio
        </a>
    </div>
</section>

<!-- Filter Bar -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-6">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-filter text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Filtros de búsqueda</h2>
            <p class="text-[11.5px] text-ink-500">Refina por región, provincia, distrito o palabra clave</p>
        </div>
    </div>

    <div class="p-4 sm:p-5">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 sm:gap-4">
            <!-- Región -->
            <div>
                <partial name="_CustomSelect" model='new {
                    Id = "filterDepartment",
                    Label = "1. Región",
                    Placeholder = "Todas las regiones",
                    Options = ((IEnumerable<dynamic>)ViewBag.Departments).Select(d => new { id = d.Id, name = d.Name })
                }' />
            </div>

            <!-- Provincia (carga dinámica) -->
            <div>
                <partial name="_CustomSelect" model='new {
                    Id = "filterProvince",
                    Label = "2. Provincia",
                    Placeholder = "Seleccione una región primero"
                }' />
            </div>

            <!-- Distrito (carga dinmica) -->
            <div>
                <partial name="_CustomSelect" model='new {
                    Id = "filterDistrict",
                    Label = "3. Distrito",
                    Placeholder = "Seleccione una provincia primero"
                }' />
            </div>

            <!-- Búsqueda rápida -->
            <div>
                <partial name="_FormInput" model='@(new {
                    Id = "filterName",
                    Name = "filterName",
                    Label = "Búsqueda rápida",
                    Placeholder = "Nombre o código modular...",
                    IconLeft = "ti-search"
                })' />
            </div>
        </div>
    </div>
</section>

<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
    <div id="tableContainer">
        @await Html.PartialAsync("_DataTable", new ViewDataDictionary(ViewData))
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/school-management/index.js" asp-append-version="true"></script>
}
