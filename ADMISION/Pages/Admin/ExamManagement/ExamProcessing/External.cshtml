@model ADMISION.Models.ViewModels.Admin.ExternalProcessFormModel
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Procesado Externo";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Procesado externo</span>
    </div>
    <div class="eyebrow">Procesamiento ad-hoc</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Procesado <span class="font-serif font-normal text-primary-600">externo</span>
        <span class="text-sm text-ink-500 font-normal italic">(sin guardar en la base de datos)</span>
    </h1>
    <p class="text-ink-500 text-sm mt-2 max-w-3xl">
        Calcula puntajes y condición de ingreso usando un <strong>perfil de calificación</strong>. Sube hasta 4 archivos:
        la <strong>clave</strong> (con TEMA o sin TEMA si es dirimencia), la <strong>identificación</strong>
        <code class="px-1.5 py-0.5 rounded bg-ink-100 dark:bg-ink-800 text-[11px] font-mono">litho → código</code>,
        las <strong>respuestas</strong>
        <code class="px-1.5 py-0.5 rounded bg-ink-100 dark:bg-ink-800 text-[11px] font-mono">litho → R1..Rn</code>
        y la <strong>BD de postulantes</strong> en Excel para enriquecer el reporte.
        El Excel se descarga al instante y <strong>no se persiste nada</strong>.
    </p>
</section>

<form asp-action="ExternalProcess" method="post" enctype="multipart/form-data"
      class="space-y-5" id="formExternal">
    @Html.AntiForgeryToken()

    <!-- Card: Título -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-tag text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Identificación del reporte</h2>
                <p class="text-[11.5px] text-ink-500">Título opcional que aparece en el Excel</p>
            </div>
        </div>
        <div class="p-4 sm:p-5">
            <label class="block text-sm font-semibold text-ink-700 dark:text-ink-200 mb-2">Título del reporte (opcional)</label>
            <div class="form-input-wrapper">
                <i class="ti ti-signature form-input-icon"></i>
                <input type="text" name="titulo" placeholder="Ej. Admisión 2024-II · Examen Ordinario" class="form-input" />
            </div>
        </div>
    </section>

    <!-- Card: Archivos -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-file-upload text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Archivos de procesamiento</h2>
                <p class="text-[11.5px] text-ink-500">Carga los CSV/DLM y opcionalmente la BD de postulantes</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="rounded-md ring-1 ring-primary-200 dark:ring-primary-500/30 bg-primary-50/40 dark:bg-primary-500/5 p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-7 h-7 rounded-full bg-primary-500 text-white text-xs font-bold flex items-center justify-center">1</span>
                    <h4 class="text-sm font-bold text-ink-900 dark:text-ink-100">Clave de respuestas</h4>
                </div>
                <p class="text-[11px] text-ink-500 mb-3 leading-relaxed">
                    Cabecera <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">TEMA,R1..RN</code> con una fila por TEMA (P, Q, R, S...) o
                    <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">R1..RN</code> sin TEMA en <strong>dirimencia</strong> (clave única).
                </p>
                <input type="file" name="keyFile" accept=".csv,.txt,.dlm" required
                       class="w-full h-10 bg-white dark:bg-ink-800 rounded-md ring-1 ring-primary-200 dark:ring-primary-500/30 px-2 py-1.5 text-xs text-ink-700 dark:text-ink-200 focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>

            <div class="rounded-md ring-1 ring-secondary-200 dark:ring-secondary-500/30 bg-secondary-50/40 dark:bg-secondary-500/5 p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-7 h-7 rounded-full bg-secondary-500 text-white text-xs font-bold flex items-center justify-center">2</span>
                    <h4 class="text-sm font-bold text-ink-900 dark:text-ink-100">Identificación <span class="text-[10px] font-normal text-ink-400">(opcional)</span></h4>
                </div>
                <p class="text-[11px] text-ink-500 mb-3 leading-relaxed">
                    Cabecera <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">LITHO,CODIGO[,TEMA]</code>. Une el <em>litho</em> de la ficha óptica
                    con el <em>código de postulante</em>. Si lo omites, LITHO se trata como código.
                </p>
                <input type="file" name="identificationFile" accept=".csv,.txt,.dlm"
                       class="w-full h-10 bg-white dark:bg-ink-800 rounded-md ring-1 ring-secondary-200 dark:ring-secondary-500/30 px-2 py-1.5 text-xs text-ink-700 dark:text-ink-200 focus:outline-none focus:ring-2 focus:ring-secondary-500" />
            </div>

            <div class="rounded-md ring-1 ring-primary-200 dark:ring-primary-500/30 bg-primary-50/40 dark:bg-primary-500/5 p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-7 h-7 rounded-full bg-primary-500 text-white text-xs font-bold flex items-center justify-center">3</span>
                    <h4 class="text-sm font-bold text-ink-900 dark:text-ink-100">Respuestas de postulantes</h4>
                </div>
                <p class="text-[11px] text-ink-500 mb-3 leading-relaxed">
                    Cabecera <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">LITHO[,TEMA],R1..RN</code>. Una fila por postulante.
                </p>
                <input type="file" name="answersFile" accept=".csv,.txt,.dlm" required
                       class="w-full h-10 bg-white dark:bg-ink-800 rounded-md ring-1 ring-primary-200 dark:ring-primary-500/30 px-2 py-1.5 text-xs text-ink-700 dark:text-ink-200 focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>

            <div class="rounded-md ring-1 ring-ink-200 dark:ring-ink-700 bg-ink-50/60 dark:bg-ink-800/40 p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-7 h-7 rounded-full bg-ink-500 text-white text-xs font-bold flex items-center justify-center">4</span>
                    <h4 class="text-sm font-bold text-ink-900 dark:text-ink-100">BD de postulantes <span class="text-[10px] font-normal text-ink-400">(opcional)</span></h4>
                </div>
                <p class="text-[11px] text-ink-500 mb-3 leading-relaxed">
                    Excel o CSV con: <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">codigo</code>, <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">Apellido_Nombre</code>,
                    <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">Carrera_Profesional</code>, <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">modalidad</code>,
                    <code class="px-1 py-0.5 rounded bg-white/70 dark:bg-ink-800 text-[10px] font-mono">tipo_modalidad</code> (opcional, puede ir en blanco). Enriquece el reporte con datos del postulante.
                </p>
                <input type="file" name="bdFile" accept=".csv,.txt,.xlsx,.xlsm,.xls"
                       class="w-full h-10 bg-white dark:bg-ink-800 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 px-2 py-1.5 text-xs text-ink-700 dark:text-ink-200 focus:outline-none focus:ring-2 focus:ring-ink-400" />
                <a href="/admin/exam-management/processing/external/template"
                   class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 mt-2">
                    <i class="ti ti-download text-xs"></i> Descargar plantilla de ejemplo
                </a>
            </div>
        </div>
    </section>

    <!-- Card: Perfil de calificación -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-adjustments-horizontal text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Perfil de calificación</h2>
                <p class="text-[11.5px] text-ink-500">Los puntajes, rangos y nota mínima se toman del perfil seleccionado</p>
            </div>
        </div>
        <div class="p-4 sm:p-5">
            @if (Model.Profiles.Count == 0)
            {
                <div class="rounded-md bg-amber-50 dark:bg-amber-500/10 ring-1 ring-amber-200 dark:ring-amber-500/30 p-4">
                    <p class="text-sm text-ink-700 dark:text-ink-200 font-medium">Aún no hay perfiles de calificación activos.</p>
                    <p class="text-xs text-ink-500 mt-1">
                        Crea al menos un perfil para poder procesar resultados.
                        <a href="/admin/exam-management/scoring-profiles" class="text-primary-600 hover:underline font-medium">Ir a Perfiles de calificación</a>.
                    </p>
                </div>
            }
            else
            {
                <label class="block text-sm font-semibold text-ink-700 dark:text-ink-200 mb-2">Perfil a usar en la calificación</label>
                <div class="form-input-wrapper">
                    <i class="ti ti-list-check form-input-icon"></i>
                    <select name="ScoringProfileId" class="form-input" required>
                        <option value="">Selecciona un perfil...</option>
                        @{
                            var weighted = Model.Profiles.Where(p => p.IsWeighted).OrderBy(p => p.Name);
                            var simple = Model.Profiles.Where(p => !p.IsWeighted).OrderBy(p => p.Name);
                        }
                        @if (weighted.Any())
                        {
                            <optgroup label="Ponderado (por rangos)">
                                @foreach (var p in weighted)
                                {
                                    <option value="@p.Id">@p.Name@(string.IsNullOrWhiteSpace(p.TermName) ? "" : $" — {p.TermName}")</option>
                                }
                            </optgroup>
                        }
                        @if (simple.Any())
                        {
                            <optgroup label="Simple (puntaje plano)">
                                @foreach (var p in simple)
                                {
                                    <option value="@p.Id">@p.Name@(string.IsNullOrWhiteSpace(p.TermName) ? "" : $" — {p.TermName}")</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <p class="text-[11px] text-ink-400 mt-2">
                    Los perfiles ponderados aplican puntos por bloque de preguntas; los simples usan un puntaje fijo por correcta.
                </p>
            }
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a href="/admin/exam-management"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit" id="btnProcess"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-file-spreadsheet text-xs"></i> Procesar y descargar Excel
        </button>
    </div>
</form>

@if (Model.Report != null)
{
    var data = Model.Report.Data;
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mt-8">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center justify-between gap-3 rounded-t-md">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                    <i class="ti ti-report text-sm"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Resultados del procesamiento</h2>
                    <p class="text-[11.5px] text-ink-500">
                        @(string.IsNullOrWhiteSpace(Model.Report.Titulo) ? "Reporte externo" : Model.Report.Titulo) · Perfil: @Model.Report.ProfileName
                    </p>
                </div>
            </div>
            <a href="/admin/exam-management/processing/external/download"
               class="btn-grad inline-flex items-center justify-center gap-2 px-4 py-2 rounded-md text-xs font-semibold hover:-translate-y-0.5 transition-all shrink-0">
                <i class="ti ti-file-spreadsheet text-sm"></i> Descargar Excel
            </a>
        </div>

        <div class="p-4 sm:p-5 grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">Preguntas</p>
                <p class="text-lg font-bold text-ink-900 dark:text-ink-100">@data.TotalPreguntas</p>
            </div>
            <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">Temas</p>
                <p class="text-lg font-bold text-ink-900 dark:text-ink-100">@data.TotalTemas</p>
            </div>
            <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">Postulantes</p>
                <p class="text-lg font-bold text-ink-900 dark:text-ink-100">@data.TotalPostulantes</p>
            </div>
            <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">Ingresantes</p>
                <p class="text-lg font-bold text-emerald-600 dark:text-emerald-400">@data.TotalIngresantes</p>
            </div>
            <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">No presentados</p>
                <p class="text-lg font-bold text-ink-900 dark:text-ink-100">@data.TotalNoPresentados</p>
            </div>
            <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">Con errores</p>
                <p class="text-lg font-bold text-ink-900 dark:text-ink-100">@data.TotalConErrores</p>
            </div>
            <div class="rounded-md @(data.TotalSinCoincidencia > 0 ? "bg-amber-50 dark:bg-amber-500/10 ring-1 ring-amber-200 dark:ring-amber-500/30" : "bg-ink-50/60 dark:bg-ink-800/40") px-3 py-2">
                <p class="text-[10px] uppercase tracking-wide text-ink-400 font-semibold">Sin coincidencia en BD</p>
                <p class="text-lg font-bold @(data.TotalSinCoincidencia > 0 ? "text-amber-600 dark:text-amber-400" : "text-ink-900 dark:text-ink-100")">@data.TotalSinCoincidencia</p>
            </div>
        </div>

        <div class="px-4 sm:px-5 pb-5 overflow-x-auto">
            <table class="w-full text-sm min-w-[1100px]">
                <thead>
                    <tr class="text-left text-[10px] uppercase tracking-wide text-ink-400">
                        <th class="py-2 pr-3 font-semibold">Nro</th>
                        <th class="py-2 pr-3 font-semibold">Código</th>
                        <th class="py-2 pr-3 font-semibold">Apellidos y Nombres</th>
                        <th class="py-2 pr-3 font-semibold">Carrera</th>
                        <th class="py-2 pr-3 font-semibold">Modalidad</th>
                        <th class="py-2 pr-3 font-semibold">Tipo modalidad</th>
                        <th class="py-2 pr-3 font-semibold">Tema</th>
                        <th class="py-2 pr-3 font-semibold text-right">Correctas</th>
                        <th class="py-2 pr-3 font-semibold text-right">Incorrectas</th>
                        <th class="py-2 pr-3 font-semibold text-right">Blancas</th>
                        <th class="py-2 pr-3 font-semibold text-right">Puntaje</th>
                        <th class="py-2 pr-3 font-semibold text-right">Nota</th>
                        <th class="py-2 font-semibold">Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < data.Rows.Count; i++)
                    {
                        var row = data.Rows[i];
                        <tr class="border-t border-ink-200/60 dark:border-ink-800/60 @(!row.Vigesimal.HasValue ? "bg-red-50/40 dark:bg-red-500/5" : !row.EncontradoEnBD ? "bg-amber-50/50 dark:bg-amber-500/5" : "")">
                            <td class="py-2 pr-3 text-ink-500">@(i + 1)</td>
                            <td class="py-2 pr-3">
                                <span class="font-mono text-xs">@row.Codigo</span>
                                @if (!row.EncontradoEnBD)
                                {
                                    <span class="ml-2 inline-flex items-center gap-1 rounded-full bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 px-2 py-0.5 text-[10px] font-semibold">
                                        <i class="ti ti-alert-triangle text-[10px]"></i> Sin BD
                                    </span>
                                }
                            </td>
                            <td class="py-2 pr-3 text-ink-700 dark:text-ink-200">@row.Nombre</td>
                            <td class="py-2 pr-3 text-ink-700 dark:text-ink-200">@row.Carrera</td>
                            <td class="py-2 pr-3 text-ink-700 dark:text-ink-200">@row.Modalidad</td>
                            <td class="py-2 pr-3 text-ink-700 dark:text-ink-200">@row.TipoModalidad</td>
                            <td class="py-2 pr-3 text-ink-700 dark:text-ink-200">@row.Tema</td>
                            <td class="py-2 pr-3 text-right text-ink-900 dark:text-ink-100 font-medium">@row.Correctas</td>
                            <td class="py-2 pr-3 text-right text-ink-900 dark:text-ink-100 font-medium">@row.Incorrectas</td>
                            <td class="py-2 pr-3 text-right text-ink-900 dark:text-ink-100 font-medium">@row.Blancas</td>
                            <td class="py-2 pr-3 text-right text-ink-900 dark:text-ink-100 font-medium">@row.Puntaje.ToString("0.0000")</td>
                            <td class="py-2 pr-3 text-right">
                                @if (row.Vigesimal.HasValue)
                                {
                                    <span class="font-semibold text-primary-600 dark:text-primary-400">@row.Vigesimal.Value.ToString("0.0000")</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 px-2 py-0.5 text-[10px] font-semibold">
                                        <i class="ti ti-alert-triangle text-[10px]"></i> Sin nota
                                    </span>
                                }
                            </td>
                            <td class="py-2 pl-3 text-xs text-ink-500">@row.Observacion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (data.Warnings.Count > 0 || data.Errors.Count > 0)
        {
            <div class="px-4 sm:px-5 pb-5">
                <div class="rounded-md bg-ink-50/60 dark:bg-ink-800/40 p-3">
                    <p class="text-[11px] font-semibold text-ink-500 mb-1">Avisos del procesamiento</p>
                    <ul class="text-xs text-ink-500 list-disc list-inside space-y-0.5">
                        @foreach (var w in data.Errors) { <li class="text-red-600 dark:text-red-400">ERROR: @w</li> }
                        @foreach (var w in data.Warnings) { <li>@w</li> }
                    </ul>
                </div>
            </div>
        }
    </section>
}

@section Scripts {
    <script src="~/js/admin/exam-management/exam-processing/external.js" asp-append-version="true"></script>
}
