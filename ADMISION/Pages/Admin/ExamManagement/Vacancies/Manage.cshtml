@model ADMISION.Models.ViewModels.Admin.VacanciesMatrixViewModel

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Gestionar Vacantes - " + Model.ModalityName;
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/exam-management/vacancies" class="hover:text-primary-600 transition-colors">Vacantes</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Gestionar</span>
    </div>
    <div class="eyebrow">Cupos de admisión</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Gestionar vacantes: <span class="font-serif font-normal text-primary-600">@Model.ModalityName</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Asigna la cantidad de cupos por carrera y tipo de modalidad.</p>
</section>

<form asp-action="SaveMatrix" method="post" class="space-y-5">
    <input type="hidden" name="modalityId" value="@Model.ModalityId" />

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-grid-dots text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Matriz de cupos</h2>
                <p class="text-[11.5px] text-ink-500">Edita los valores y guarda para actualizar la modalidad</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="atlas w-full text-center">
                <thead>
                    <tr>
                        <th class="text-left sticky left-0 bg-ink-50/80 dark:bg-ink-800/60 z-10 w-64">Carreras profesionales</th>
                        @if (Model.TypeModalities.Any())
                        {
                            @foreach (var type in Model.TypeModalities)
                            {
                                <th class="min-w-[110px]">@type.Name</th>
                            }
                        }
                        else
                        {
                            <th>Vacantes asignadas</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var career in Model.Careers)
                    {
                        <tr>
                            <td class="text-left font-semibold text-ink-900 dark:text-ink-100 sticky left-0 bg-white dark:bg-ink-900 z-10">@career.Name</td>
                            @if (Model.TypeModalities.Any())
                            {
                                @foreach (var type in Model.TypeModalities)
                                {
                                    <td class="p-1.5">
                                        @{
                                            int qty = Model.GetQuantity(career.Id, type.Id);
                                            string key = $"{career.Id}_{type.Id}";
                                        }
                                        <input type="number" name="quantities[@key]" value="@qty" min="0" style="max-width:110px;"
                                               class="w-full h-10 bg-white dark:bg-ink-800 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 text-center font-mono tabular-nums text-sm text-ink-900 dark:text-ink-100 px-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:bg-primary-50/30 dark:focus:bg-primary-500/5 transition-all" />
                                    </td>
                                }
                            }
                            else
                            {
                                <td class="p-1.5">
                                    @{
                                        var vac = Model.Vacancies.FirstOrDefault(v => v.CareerId == career.Id && v.TypeModalityId == null);
                                        int qty2 = vac?.Quantity ?? 0;
                                        string key2 = $"{career.Id}_null";
                                    }
                                    <input type="number" name="quantities[@key2]" value="@qty2" min="0" style="max-width:110px;"
                                           class="w-full h-10 bg-white dark:bg-ink-800 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 text-center font-mono tabular-nums text-sm text-ink-900 dark:text-ink-100 px-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:bg-primary-50/30 dark:focus:bg-primary-500/5 transition-all" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.TypeModalities.Any() && !Model.Careers.Any())
            {
                <div class="py-14 text-center">
                    <i class="ti ti-armchair text-4xl text-ink-300 mb-3 block"></i>
                    <p class="text-ink-400 text-sm font-medium">No hay carreras registradas para gestionar vacantes.</p>
                </div>
            }
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index" asp-route-modalityId="@Model.ModalityId"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar cambios
        </button>
    </div>
</form>
