@using ADMISION.ENTITIES.Constants
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Gestión de Examen";

    var isAdmin = User.IsInRole(AppConstants.Roles.SuperAdmin) || User.IsInRole(AppConstants.Roles.Admin);


    var AdminSections = new[] {
        new { Href = "/admin/exam-management/modalities",                  Icon = "ti-list",             Title = "Modalidades",                   Hint = "Ingresos ordinarios, CEPRE y especiales.", Tone = "primary" },
        new { Href = "/admin/exam-management/modality-types",              Icon = "ti-stack-2",         Title = "Tipos de Modalidad",            Hint = "Categorización jerárquica de ingresos.",   Tone = "secondary" },
        new { Href = "/admin/exam-management/careers",                     Icon = "ti-school",      Title = "Carreras",                      Hint = "Gestión de programas de estudio activos.", Tone = "primary" },
        new { Href = "/admin/exam-management/faculties",                   Icon = "ti-building-bank",    Title = "Facultades",                    Hint = "Estructura orgánica de facultades.",       Tone = "secondary" },
        new { Href = "/admin/exam-management/documents",                   Icon = "ti-file-text",          Title = "Requisitos Docs.",              Hint = "Catálogo de documentación oficial exigida.", Tone = "primary" },
        new { Href = "/admin/exam-management/requirements-by-modality",    Icon = "ti-sitemap",     Title = "Requisitos / Modalidad",        Hint = "Asignación de requisitos por tipo de ingreso.", Tone = "secondary" },
        new { Href = "/admin/exam-management/applicant-types",             Icon = "ti-id-badge",            Title = "Tipos de Postulante",           Hint = "Segmentación de perfiles de ingreso.",     Tone = "primary" },
        new { Href = "/admin/exam-management/vacancies",                   Icon = "ti-armchair",               Title = "Vacantes",                      Hint = "Control de cupos por carrera y modalidad.", Tone = "secondary" },
        new { Href = "/admin/exam-management/tematic-areas",               Icon = "ti-book",           Title = "Áreas Temáticas",               Hint = "Gestión de áreas de evaluación por carrera.", Tone = "primary" },
        new { Href = "/admin/exam-management/requirements-by-type-postulant", Icon = "ti-file-pencil", Title = "Requisitos por Tipo Postulante", Hint = "Documentos requeridos según condición del postulante.", Tone = "secondary" },
        new { Href = "/admin/exam-management/disability-types/",           Icon = "ti-wheelchair",          Title = "Discapacidades",                Hint = "Lista de tipos de discapacidad según SUNEDU.", Tone = "primary" },
        new { Href = "/admin/exam-management/results",                     Icon = "ti-file-type-pdf",            Title = "Publicación de Resultados",     Hint = "Sube los PDFs oficiales por periodo y modalidad.", Tone = "secondary" },
        new { Href = "/admin/exam-management/processing/external",         Icon = "ti-calculator",          Title = "Procesado Externo",             Hint = "Calcula puntajes sin guardar; descarga el Excel.", Tone = "secondary" },
        new { Href = "/admin/exam-management/scoring-profiles",            Icon = "ti-adjustments",        Title = "Perfiles de Calificación",       Hint = "Configura puntajes simples o ponderados por rangos.", Tone = "primary" },
    };
}

<!-- Page hero -->
<section class="fade-up mb-5">
    <nav class="flex items-center gap-2 text-xs text-ink-400 mb-2" aria-label="Breadcrumb">
        <a href="/admin" class="hover:text-primary-600 transition-colors">Admin</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Gestión de Examen</span>
    </nav>
    <div class="eyebrow">Configuración académica</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Gestión de <span class="font-serif font-normal text-primary-600">examen</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1.5 max-w-2xl">
        Administra modalidades, carreras, facultades, requisitos, áreas temáticas y vacantes del proceso de admisión.
    </p>
</section>

<!-- Hub grid -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">

    @if (isAdmin)
    {
        foreach (var s in AdminSections)
        {
            var iconBg   = s.Tone == "primary" ? "bg-primary-50 dark:bg-primary-500/10"     : "bg-secondary-50 dark:bg-secondary-500/10";
            var iconText = s.Tone == "primary" ? "text-primary-600 dark:text-primary-300"   : "text-secondary-600 dark:text-secondary-300";

            <a href="@s.Href"
               class="fade-up group bg-white dark:bg-ink-900 rounded-md ring-soft p-5 lift transition-all flex flex-col gap-3 hover:ring-primary-300/60 dark:hover:ring-primary-500/30">
                <span class="w-11 h-11 rounded-md @iconBg @iconText flex items-center justify-center text-[15px] group-hover:scale-[1.03] transition-transform">
                    <i class="ti @s.Icon"></i>
                </span>
                <div>
                    <h4 class="font-semibold text-ink-900 dark:text-ink-100 text-[14px] tracking-tight">@s.Title</h4>
                    <p class="text-[11.5px] text-ink-500 mt-1 leading-relaxed">@s.Hint</p>
                </div>
                <div class="mt-auto pt-2 flex items-center gap-1.5 text-[11px] font-semibold text-primary-600 opacity-0 group-hover:opacity-100 transition-opacity">
                    Abrir <i class="ti ti-arrow-right text-[9px]"></i>
                </div>
            </a>
        }
    }
</section>
