@model ADMISION.ENTITIES.Models.Requirement.TypePostulantRequisite

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Asignar Requisito a Tipo de Postulante";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/exam-management/requirements-by-type-postulant" class="hover:text-primary-600 transition-colors">Requisitos por tipo</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Asignar nuevo</span>
    </div>
    <div class="eyebrow">Documentación</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Asignar nuevo <span class="font-serif font-normal text-primary-600">requisito</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Vincula un requisito a un tipo de postulante específico.</p>
</section>

<form asp-action="Create" method="post" class="space-y-5 max-w-2xl">
    @Html.AntiForgeryToken()

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-user text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos de la asignación</h2>
                <p class="text-[11.5px] text-ink-500">Selecciona el tipo y el requisito a vincular</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <!-- Tipo de Postulante -->
            <div>
                <partial name="_CustomSelect" model='new {
                    Id = "TypePostulantInscriptionId",
                    Name = "TypePostulantInscriptionId",
                    Label = "Tipo de postulante",
                    Placeholder = "Seleccionar categoría de postulante",
                    Options = ((IEnumerable<dynamic>)ViewData["PostulantTypes"]).Select(t => new { id = t.Id, name = t.Name }),
                    Required = true
                }' />
                <span asp-validation-for="TypePostulantInscriptionId" class="form-error"></span>
            </div>

            <!-- Requisito -->
            <div>
                <partial name="_CustomSelect" model='new {
                    Id = "FileRequirementManagementId",
                    Name = "FileRequirementManagementId",
                    Label = "Requisito a solicitar",
                    Placeholder = "Buscar requisito...",
                    Options = ((IEnumerable<dynamic>)ViewData["Requirements"]).Select(r => new { id = r.Id, name = r.Name }),
                    Required = true
                }' />
                <span asp-validation-for="FileRequirementManagementId" class="form-error"></span>
            </div>
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar asignación
        </button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        window.TypePostulantRequisitesCreateConfig = {
            selectedTypeId: '@ViewBag.SelectedTypePostulantId',
            types: @Html.Raw(Json.Serialize(((IEnumerable<dynamic>)ViewData["PostulantTypes"]).Select(t => new { t.Id, t.Name })))
        };
    </script>
    <script src="~/js/admin/exam-management/type-postulant-requisites/create.js" asp-append-version="true"></script>
}
