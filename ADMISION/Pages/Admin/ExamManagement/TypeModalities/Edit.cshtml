@model ADMISION.ENTITIES.Models.Modality.TypeModality

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Tipo de Modalidad";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/exam-management/modality-types" class="hover:text-primary-600 transition-colors">Tipos de modalidad</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Editar</span>
    </div>
    <div class="eyebrow">Configuración de examen</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Editar <span class="font-serif font-normal text-primary-600">@Model.Name</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Modifica el tipo de modalidad y su configuración.</p>
</section>

<form asp-action="Edit" method="post" class="space-y-5 max-w-3xl">

    <input type="hidden" asp-for="Id" />

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-stack-2 text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Selección de modalidad</h2>
                <p class="text-[11.5px] text-ink-500">Periodo y modalidad a la que pertenece este tipo</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-4">
                <div>
                    <partial name="_CustomSelect" model='new {
                        Id = "TermId",
                        Label = "Periodo académico",
                        Placeholder = "Seleccione un periodo",
                        Options = ((IEnumerable<dynamic>)ViewData["Terms"]).Select(t => new { id = t.Id, name = t.Name }),
                        Required = true
                    }' />
                </div>

                <div>
                    <partial name="_CustomSelect" model='new {
                        Id = "ModalityId",
                        Name = "ModalityId",
                        Label = "Modalidad",
                        Placeholder = "Seleccione una modalidad",
                        Options = ((IEnumerable<dynamic>)(ViewData["Modalities"] ?? Enumerable.Empty<dynamic>())).Select(m => new { id = m.Id, name = m.Name }),
                        Required = true
                    }' />
                    <span asp-validation-for="ModalityId" class="text-xs text-rose-500 mt-1 font-medium"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-edit text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos del tipo</h2>
                <p class="text-[11.5px] text-ink-500">Identificación, descuento y estado</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <partial name="_FormInput" model='@(new {
                Id = "Name", Name = "Name",
                Label = "Nombre del tipo", Required = true,
                Value = Model.Name,
                IconLeft = "ti-tag",
                Error = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-4">
                <partial name="_FormInput" model='@(new {
                    Id = "DiscountPercentage", Name = "DiscountPercentage",
                    Label = "Descuento (%)",
                    Type = "number", Step = "0.01",
                    Value = Model.DiscountPercentage.ToString(),
                    IconLeft = "ti-percentage",
                    Error = ViewData.ModelState["DiscountPercentage"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />

                <div class="flex items-end pb-1">
                    <partial name="_FormCheckbox" model='@(new {
                        Id = "IsActive", Name = "IsActive",
                        Label = "Tipo activo",
                        Hint = "Visible en las opciones",
                        Checked = Model.IsActive,
                        Variant = "switch"
                    })' />
                </div>
            </div>

            <partial name="_FormTextarea" model='@(new {
                Id = "Description", Name = "Description",
                Label = "Descripción",
                Rows = 3,
                Value = Model.Description,
                Error = ViewData.ModelState["Description"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />
        </div>
    </section>

    <!-- Card: Carreras disponibles -->
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-building-arch text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Carreras disponibles</h2>
                <p class="text-[11.5px] text-ink-500">Selecciona las carreras que aplican para este tipo de modalidad. Si no seleccionas ninguna, se heredarán las carreras de la modalidad padre.</p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <div id="careersContainer">
                @if (ViewBag.AllCareers != null && ((IEnumerable<ADMISION.ENTITIES.Models.Modality.Career>)ViewBag.AllCareers).Any())
                {
                    var associatedIds = (ViewBag.AssociatedCareerIds as List<Guid>) ?? new List<Guid>();
                    var idSet = new HashSet<Guid>(associatedIds);
                    <div class="flex flex-col gap-2">
                        @foreach (var career in (IEnumerable<ADMISION.ENTITIES.Models.Modality.Career>)ViewBag.AllCareers)
                        {
                            var isChecked = idSet.Contains(career.Id);
                            <label class="career-item flex items-center gap-3 p-3 rounded-md ring-1 ring-ink-200/60 dark:ring-ink-800 cursor-pointer hover:bg-primary-50/50 dark:hover:bg-primary-500/5 transition-colors">
                                <input type="checkbox" name="careerIds" value="@career.Id"
                                       @(isChecked ? "checked" : "")
                                       class="w-4 h-4 rounded border-ink-300 text-primary-600 focus:ring-primary-500" />
                                <div class="min-w-0">
                                    <span class="text-sm font-medium text-ink-800 dark:text-ink-200 block">@career.Name</span>
                                    @if (career.Faculty != null)
                                    {
                                        <span class="text-[10px] text-ink-400 block">@career.Faculty.Name</span>
                                    }
                                </div>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-ink-500 italic">No hay carreras registradas en el sistema.</p>
                }
            </div>
        </div>
    </section>

    <!-- Acciones -->
    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar cambios
        </button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        window.TypeModalitiesEditConfig = {
            currentTermId: '@ViewData["CurrentTermId"]',
            currentModalityId: '@Model.ModalityId',
            currentModalityName: '@(Model.Modality?.Name ?? "Seleccione...")',
            terms: @Html.Raw(Json.Serialize(((IEnumerable<dynamic>)ViewData["Terms"]).Select(t => new { t.Id, t.Name }))),
            allCareers: @Html.Raw(Json.Serialize(((IEnumerable<ADMISION.ENTITIES.Models.Modality.Career>)ViewBag.AllCareers).Select(c => new { id = c.Id.ToString(), name = c.Name, facultyName = c.Faculty?.Name }))),
            associatedCareerIds: @Html.Raw(Json.Serialize((((List<Guid>)(ViewBag.AssociatedCareerIds ?? new List<Guid>())) ?? new List<Guid>()).Select(id => id.ToString()).ToList()))
        };
        window.careerModalityMap = @Html.Raw(Json.Serialize(ViewBag.ModalityCareerMap ?? new Dictionary<Guid, List<Guid>>()));
    </script>
    <script src="~/js/admin/exam-management/type-modalities/edit.js" asp-append-version="true"></script>
}
