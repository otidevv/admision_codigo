@using ADMISION.Models.Shared
@model IEnumerable<ADMISION.ENTITIES.Models.Modality.Career>

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Gestión de Carreras";

    var columns = new List<DataTableColumn>
    {
        new() { Label = "Nombre / Código", Field = "name", Type = "combined", SubField = "code", Sortable = true },
        new() { Label = "N.° Programa", Field = "programNumber", Sortable = true },
        new() { Label = "Facultad", Field = "faculty.name", Sortable = true },
        new() {
            Label = "Estado",
            Field = "isActive",
            Type = "badge",
            Sortable = true,
            BadgeMap = new() {
                { "true", "green" },
                { "false", "gray" }
            }
        }
    };
    var isSuperAdmin = User.IsInRole(AppConstants.Roles.SuperAdmin) || User.IsInRole(AppConstants.Roles.Admin);

    List<DataTableAction> actions = null;
    if (isSuperAdmin)
    {
        actions = new List<DataTableAction>
        {
            new() { Key = "edit", Label = "Editar", Icon = "ti-edit", Href = "/admin/exam-management/careers/editar/{id}" },
            new() { Key = "delete", Label = "Eliminar", Icon = "ti-trash", Danger = true },
        };
    }

    ViewData["Columns"] = columns;
    ViewData["Actions"] = actions;
    ViewData["ShowActions"] = isSuperAdmin;
    ViewData["AjaxUrl"] = Url.Action("Index");
    ViewData["TableId"] = "careersTable";
    ViewData["EmptyIcon"] = "ti-school";
    ViewData["EmptyTitle"] = "Sin carreras";
    ViewData["EmptySubtitle"] = "No se encontraron carreras con los filtros actuales.";

    var facultyOptions = ((IEnumerable<dynamic>)ViewBag.Faculties)
        .Select(f => new { id = f.Id.ToString(), name = (string)f.Name })
        .ToList();
}

<!-- Page hero -->
<section class="fade-up flex flex-wrap items-end justify-between gap-4 mb-5">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
            <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
            <i class="ti ti-chevron-right text-[9px]"></i>
            <span class="text-ink-700 dark:text-ink-200 font-medium">Carreras</span>
        </div>
        <div class="eyebrow">Configuración académica</div>
        <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
            Carreras <span class="font-serif font-normal text-primary-600">profesionales</span>
        </h1>
        <p class="text-ink-500 text-sm mt-1">Administra las carreras ofrecidas por la institución.</p>
    </div>
    <div class="flex items-center gap-2">
        <button type="button" onclick="DT.refresh('careersTable')"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-refresh text-xs"></i> Actualizar
        </button>
        @if (User.IsInRole(AppConstants.Roles.SuperAdmin) || User.IsInRole(AppConstants.Roles.Admin))
        {
            <a asp-action="Create"
               class="btn-grad inline-flex items-center gap-2 text-sm font-semibold px-4 py-2.5 rounded-md hover:-translate-y-0.5 transition-all">
                <i class="ti ti-plus text-xs"></i>
                Nueva carrera
            </a>
        }
    </div>
</section>

<!-- Filtros -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft mb-5">
    <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
        <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
            <i class="ti ti-filter text-sm"></i>
        </span>
        <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Filtros de búsqueda</h2>
            <p class="text-[11.5px] text-ink-500">Refina el listado por facultad o por texto</p>
        </div>
    </div>

    <div class="p-4 sm:p-5">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 sm:gap-4">
            <div class="md:col-span-1">
                <partial name="_CustomSelect" model='@(new {
                    Id = "filterFaculty",
                    Label = "Facultad",
                    Placeholder = "Todas las facultades",
                    Options = facultyOptions
                })' />
            </div>

            <div class="md:col-span-3">
                <label for="filterSearch" class="block text-sm font-semibold text-ink-700 dark:text-ink-200 mb-2">
                    Buscar por carrera o código
                </label>
                <div class="form-input-wrapper">
                    <i class="ti ti-search form-input-icon"></i>
                    <input type="text" id="filterSearch" class="form-input"
                           placeholder="Escriba el nombre o código de la carrera...">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tabla -->
<section class="fade-up" id="tableContainer">
    @await Html.PartialAsync("_DataTable", new ViewDataDictionary(ViewData))
</section>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/admin/exam-management/careers/index.js" asp-append-version="true"></script>
}
