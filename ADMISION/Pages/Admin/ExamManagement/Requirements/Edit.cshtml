@model ADMISION.ENTITIES.Models.Requirement.FileRequirementManagement

@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Requisito";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/exam-management/documents" class="hover:text-primary-600 transition-colors">Requisitos</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Editar</span>
    </div>
    <div class="eyebrow">Documentación</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Editar <span class="font-serif font-normal text-primary-600">@Model.Name</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Modifica los datos del requisito y guarda los cambios.</p>
</section>

<form asp-action="Edit" method="post" class="space-y-5 max-w-3xl">
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-edit text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos del requisito</h2>
                <p class="text-[11.5px] text-ink-500">Identificación y descripción</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <input type="hidden" asp-for="Id" />

            <partial name="_FormInput" model='@(new {
                Id = "Name", Name = "Name",
                Label = "Nombre", Required = true,
                Value = Model.Name,
                IconLeft = "ti-file-pencil",
                Error = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />

            <div class="form-field">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" rows="3" class="form-input"></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>
        </div>
    </section>

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md bg-secondary-50/40">
            <span class="w-9 h-9 rounded-md bg-secondary-100 text-secondary-700 inline-flex items-center justify-center">
                <i class="ti ti-file-code text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Formatos permitidos</h2>
                <p class="text-[11.5px] text-ink-500">Marca las extensiones aceptadas para este requisito</p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <input type="hidden" asp-for="FilePathExtencion" id="FilePathExtencion" />
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                @foreach (var ext in ViewBag.AllowedExtensions as List<string>)
                {
                    <label class="flex items-center gap-2.5 p-3 rounded-md ring-1 ring-ink-200 dark:ring-ink-700 cursor-pointer hover:bg-primary-50 dark:hover:bg-primary-500/10 hover:ring-primary-300 transition-all">
                        <input type="checkbox" value="@ext"
                               class="extension-checkbox h-4 w-4 text-primary-600 border-ink-300 rounded focus:ring-primary-500" />
                        <span class="text-sm text-ink-700 dark:text-ink-200 font-medium">@ext</span>
                    </label>
                }
            </div>
            <span asp-validation-for="FilePathExtencion" class="form-error mt-2"></span>
        </div>
    </section>

    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-adjustments text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Parámetros</h2>
                <p class="text-[11.5px] text-ink-500">Tamaño máximo y etapa de visualización</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <partial name="_FormInput" model='@(new {
                    Id = "MaxFileSizeMB", Name = "MaxFileSizeMB",
                    Label = "Tamaño máximo (MB)", Required = false,
                    Type = "number",
                    Step = "0.1", Min = "0",
                    Value = Model.MaxFileSizeMB.ToString(),
                    IconLeft = "ti-weight",
                    Error = ViewData.ModelState["MaxFileSizeMB"]?.Errors.FirstOrDefault()?.ErrorMessage
                })' />

                <div class="form-field">
                    <label asp-for="Stage" class="form-label">Etapa</label>
                    <select asp-for="Stage" class="form-input">
                        @foreach (var o in (List<ADMISION.ENTITIES.Constants.SelectOption>?)ViewBag.StageOptions ?? new())
                        {
                            <option value="@o.Value" selected="@(Model.Stage == o.Value)">@o.Label</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Actualizar
        </button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/admin/exam-management/requirements/form.js" asp-append-version="true"></script>
}
