@model ADMISION.ENTITIES.Models.Postulant.DisabilityType
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nuevo Tipo de Discapacidad";
}

<!-- Breadcrumb + page hero -->
<section class="fade-up mb-5">
    <div class="flex items-center gap-2 text-xs text-ink-400 mb-3">
        <a href="/admin/exam-management" class="hover:text-primary-600 transition-colors">Gestión de examen</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <a href="/admin/exam-management/disability-types" class="hover:text-primary-600 transition-colors">Tipos de discapacidad</a>
        <i class="ti ti-chevron-right text-[9px]"></i>
        <span class="text-ink-700 dark:text-ink-200 font-medium">Nuevo</span>
    </div>
    <div class="eyebrow">Inclusión y accesibilidad</div>
    <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
        Registrar nuevo <span class="font-serif font-normal text-primary-600">tipo</span>
    </h1>
    <p class="text-ink-500 text-sm mt-1">Define un nuevo tipo de discapacidad que podrá asignarse a los postulantes.</p>
</section>

<form asp-action="Create" method="post" class="space-y-5 max-w-2xl">
    <section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft">
        <div class="px-4 sm:px-5 py-4 border-b border-ink-200/60 dark:border-ink-800/60 flex items-center gap-3 rounded-t-md">
            <span class="w-9 h-9 rounded-md bg-primary-50 dark:bg-primary-500/10 text-primary-600 inline-flex items-center justify-center">
                <i class="ti ti-accessible text-sm"></i>
            </span>
            <div>
                <h2 class="font-semibold text-ink-900 dark:text-ink-100 tracking-tight text-[15px]">Datos del tipo</h2>
                <p class="text-[11.5px] text-ink-500">Identificación y descripción</p>
            </div>
        </div>

        <div class="p-4 sm:p-5 space-y-5">
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-rose-700 bg-rose-50 ring-1 ring-rose-200 p-3 rounded-md"></div>

            <partial name="_FormInput" model='@(new {
                Id = "Name", Name = "Name",
                Label = "Nombre", Required = true,
                Placeholder = "Ej. Visual, Motora...",
                Value = Model?.Name,
                IconLeft = "ti-accessible",
                Error = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage
            })' />

            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-ink-700 dark:text-ink-200 mb-2">
                    Descripción
                </label>
                <textarea asp-for="Description" rows="3"
                          placeholder="Describe brevemente el tipo de discapacidad..."
                          class="w-full bg-white dark:bg-ink-800 border border-ink-200 dark:border-ink-700 rounded-md px-4 py-3 text-sm text-ink-900 dark:text-ink-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all"></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-500 mt-1"></span>
            </div>

            <partial name="_FormCheckbox" model='@(new {
                Id = "IsActive", Name = "IsActive",
                Label = "Tipo activo",
                Hint  = "Visible y seleccionable en formularios de postulación",
                Checked = Model?.IsActive ?? true,
                Variant = "card"
            })' />
        </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-white dark:bg-ink-800 ring-soft text-ink-700 dark:text-ink-200 text-sm font-semibold hover:bg-ink-100 dark:hover:bg-ink-700 transition-all">
            <i class="ti ti-arrow-left text-xs"></i> Cancelar
        </a>
        <button type="submit"
                class="btn-grad inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 transition-all">
            <i class="ti ti-device-floppy text-xs"></i> Guardar
        </button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
