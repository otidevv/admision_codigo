@model IEnumerable<ADMISION.ENTITIES.Models.Infrastructure.Classroom>
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Salones y Aforo";
    var pavilions = (IEnumerable<ADMISION.Services.Interfaces.PavilionOption>)ViewBag.Pavilions
                    ?? Enumerable.Empty<ADMISION.Services.Interfaces.PavilionOption>();
    var selectedId = (Guid?)ViewBag.SelectedPavilionId;
}

<!-- Page hero -->
<section class="fade-up flex flex-wrap items-end justify-between gap-4 mb-5">
    <div>
        <div class="flex items-center gap-2 text-xs text-ink-400 mb-2">
            <a href="/admin/infrastructure" class="hover:text-primary-600 transition-colors">Infraestructura</a>
            <i class="ti ti-chevron-right text-[9px]"></i>
            <span class="text-ink-700 dark:text-ink-200 font-medium">Salones</span>
        </div>
        <div class="eyebrow">Logística del examen</div>
        <h1 class="mt-1 text-2xl sm:text-[28px] font-semibold tracking-[-0.02em] text-ink-900 dark:text-ink-100">
            Salones &amp; <span class="font-serif font-normal text-primary-600">aforo</span>
        </h1>
        <p class="text-ink-500 text-sm mt-1">Registra salones por pabellón y piso. El aforo es la cantidad de sillas/butacas disponibles por salón.</p>
    </div>
    <a asp-action="Create" class="btn-grad inline-flex items-center gap-2 text-sm font-semibold px-4 py-2.5 rounded-md hover:-translate-y-0.5 transition-all">
        <i class="ti ti-plus text-xs"></i> Nuevo salón
    </a>
</section>

<!-- Filtros -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft p-5 mb-6">
    <form method="get" class="flex flex-wrap items-end gap-4">
        <div class="flex-1 min-w-[260px]">
            <label class="block text-sm font-semibold text-ink-700 dark:text-ink-200 mb-2">Filtrar por pabellón</label>
            <div class="relative">
                <i class="ti ti-building absolute left-3 top-1/2 -translate-y-1/2 text-ink-400 text-sm"></i>
                <select name="pavilionId" onchange="this.form.submit()"
                        class="w-full h-9 bg-white dark:bg-ink-800 ring-1 ring-ink-200 dark:ring-ink-700 rounded-md pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all">
                    <option value="">Todos</option>
                    @foreach (var p in pavilions)
                    {
                        <option value="@p.Id" selected="@(selectedId == p.Id)">@p.Code — @p.Name</option>
                    }
                </select>
            </div>
        </div>
    </form>
</section>

<!-- Tabla -->
<section class="fade-up bg-white dark:bg-ink-900 rounded-md ring-soft overflow-hidden">
    <div class="overflow-x-auto">
        <table class="atlas w-full">
            <thead>
                <tr>
                    <th>Pabellón</th>
                    <th class="text-center">Piso</th>
                    <th>Salón</th>
                    <th>Grupo</th>
                    <th class="text-center">Aforo</th>
                    <th>Estado</th>
                    <th class="text-right">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge b-blue">@item.Pavilion?.Code</span>
                            <span class="text-ink-500 text-xs ml-1">@item.Pavilion?.Name</span>
                        </td>
                        <td class="text-center text-ink-700 dark:text-ink-200">@item.Floor</td>
                        <td class="font-semibold text-ink-900 dark:text-ink-100">@item.Name</td>
                        <td class="text-ink-700 dark:text-ink-200">@(item.Group ?? "—")</td>
                        <td class="text-center text-ink-700 dark:text-ink-200">@item.Capacity</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge b-green">Activo</span>
                            }
                            else
                            {
                                <span class="badge b-gray">Inactivo</span>
                            }
                        </td>
                        <td class="text-right">
                            <div class="flex justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="inline-flex items-center justify-center w-8 h-8 rounded-md ring-1 ring-primary-200 dark:ring-primary-500/30 text-primary-600 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-500/10 transition-colors"
                                   title="Editar">
                                    <i class="ti ti-edit text-xs"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline delete-form">
                                    @Html.AntiForgeryToken()
                                    <button type="button"
                                            class="btn-delete inline-flex items-center justify-center w-8 h-8 rounded-md ring-1 ring-rose-200 dark:ring-rose-500/30 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors"
                                            data-name="@item.Name"
                                            title="Eliminar">
                                        <i class="ti ti-trash text-xs"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="py-14 text-center">
            <i class="ti ti-door text-4xl text-ink-300 mb-3 block"></i>
            <p class="text-ink-400 text-sm font-medium">No hay salones registrados.</p>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/admin/infrastructure/classrooms/index.js" asp-append-version="true"></script>
}
